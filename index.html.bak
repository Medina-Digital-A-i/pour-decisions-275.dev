      blurb:'Turmeric, cinnamon and honey steamed into a caffeine-free golden hug.' },
    { id:'hibiscus', name:'Hibiscus Cooler', cat:'Tea', kind:'Coffee & Tea', price:4, cal:60, emoji:'🌺',
      grad:'linear-gradient(150deg,#FF6FA0,#AD1457)', shadow:'rgba(173,20,87,.35)', text:'#fff', tagBg:'rgba(255,255,255,.9)', tagFg:'#AD1457',
      ingredients:'Hibiscus · Lime · Fresh mint',
      blurb:'Ruby-red iced hibiscus with lime — tart, floral, endlessly refreshing.' }
  ];

  CATS = ['All','Juices','Smoothies','Shots','Bowls','Breakfast','Eats','Salads & Soup','Coffee & Tea'];
  WHEEL = ['green','berry','lose','citrus','tropic','purple','melon','lose','acai','ginger'];

  _ls(k, d){ try { const v = localStorage.getItem(k); return v !== null ? JSON.parse(v) : d; } catch(e) { return d; } }
  _sv(k, v){ try { localStorage.setItem(k, JSON.stringify(v)); } catch(e) {} }

  BENEFITS = {
    green:['Detox & digestion','Iron + vitamin K','Low sugar'],
    berry:['Antioxidant-rich','Heart health','Natural energy'],
    citrus:['Immunity boost','Vitamin C + A','Anti-inflammatory'],
    tropic:['Deep hydration','Vitamin C','Mood lift'],
    purple:['Antioxidants','Stamina & blood flow','Liver support'],
    melon:['Ultra hydrating','Low calorie','Muscle recovery'],
    acai:['Omega fats','Antioxidants','Lasting energy'],
    ginger:['Immunity kick','Digestion aid','Anti-inflammatory'],
    pb:['18g plant protein','Muscle recovery','Keeps you full'],
    turmeric:['Anti-inflammatory','Joint support','Immunity'],
    wheatgrass:['Chlorophyll detox','Alkalizing','Micronutrients'],
    pitaya:['Vitamin C','Fiber-rich','Gut health'],
    oats:['Slow-release energy','High fiber','Heart healthy'],
    avotoast:['Healthy fats','Fiber','Potassium'],
    pesto:['28g protein','Whole grains','Fresh basil'],
    caprese:['Calcium + protein','Lycopene','Light & fresh'],
    hummus:['Plant protein','High fiber','Heart healthy'],
    veggiepatty:['Baked, not fried','Plant-based','Turmeric crust'],
    jerkpatty:['Lean protein','Baked, not fried','Metabolism kick'],
    kalecaesar:['Vitamin K','Plant protein','Gut-friendly'],
    rainbow:['Phytonutrients','Complete protein','Light & filling'],
    carrotsoup:['Beta-carotene','Immunity','Warming & light'],
    tomatosoup:['Lycopene','Low calorie','Heart health'],
    coldbrew:['Clean caffeine','Zero sugar','Antioxidants'],
    matcha:['Calm, focused energy','L-theanine','Antioxidants'],
    goldenlatte:['Caffeine-free','Anti-inflammatory','Evening-safe'],
    hibiscus:['Vitamin C','Heart support','Caffeine-free']
  };

  fmt(n){ return '$' + n.toFixed(n % 1 === 0 ? 0 : 2); }
  themeGrad(){
    const t = {
      Sunset:'linear-gradient(160deg,#E8426A 0%,#C4284E 55%,#8B1A35 100%)',
      Citrus:'linear-gradient(160deg,#E8426A 0%,#FF6B35 55%,#E8B547 100%)',
      Berry:'linear-gradient(160deg,#9B2D6E 0%,#E8426A 50%,#C4284E 100%)'
    };
    return t[this.props.splashTheme ?? this.state.theme] || t.Sunset;
  }

  go(screen){ this.setState(s => ({ prev: s.screen, screen })); }
  // ─── Internal: complete OAuth sign-in with name/email from any provider ───
  _handleOAuthSignIn(name, email) {
    const displayName = (name || 'Guest').trim();
    const user = { name: displayName, initial: displayName[0].toUpperCase(), email: email || '' };
    this._sv('pd_signedIn', true);
    this._sv('pd_user', user);
    this.setState({ signedIn: true, prev: 'auth', screen: 'home', user, authName: '', authEmail: '' });
  }

  // ─── Google Sign-In via Google Identity Services ───────────────────────
  // SETUP: Replace YOUR_GOOGLE_CLIENT_ID with your real Client ID from
  //        https://console.cloud.google.com/apis/credentials
  doGoogleSignIn() {
    if (typeof google === 'undefined' || !google.accounts) {
      // SDK not yet loaded — try again in 1 second
      setTimeout(() => this.doGoogleSignIn(), 1000);
      return;
    }
    google.accounts.id.initialize({
      client_id: 'YOUR_GOOGLE_CLIENT_ID', // ← replace with real Client ID
      callback: (response) => {
        try {
          // Decode the JWT credential to extract user profile
          const payload = JSON.parse(atob(response.credential.split('.')[1]));
          const name = payload.name || payload.given_name || 'Google User';
          const email = payload.email || '';
          this._handleOAuthSignIn(name, email);
        } catch (e) {
          console.error('[Pour Decisions] Google sign-in decode error:', e);
          alert('Google sign-in failed. Please try again.');
        }
      },
      context: 'signin',
      ux_mode: 'popup'
    });
    // Trigger the Google One Tap / sign-in popup
    google.accounts.id.prompt((notification) => {
      if (notification.isNotDisplayed() || notification.isSkippedMoment()) {
        // One Tap suppressed — fall back to renderButton approach
        const container = document.createElement('div');
        container.style.display = 'none';
        document.body.appendChild(container);
        google.accounts.id.renderButton(container, { type: 'standard' });
        container.querySelector('[role="button"]')?.click();
        setTimeout(() => document.body.removeChild(container), 500);
      }
    });
  }

  // ─── Apple Sign In via Sign in with Apple JS ───────────────────────────
  // SETUP: Replace YOUR_APPLE_SERVICE_ID with your real Apple Services ID from
  //        https://developer.apple.com/account/resources/identifiers
  doAppleSignIn() {
    if (typeof AppleID === 'undefined' || !AppleID.auth) {
      setTimeout(() => this.doAppleSignIn(), 1000);
      return;
    }
    AppleID.auth.init({
      clientId: 'YOUR_APPLE_SERVICE_ID', // ← replace with real Services ID
      scope: 'name email',
      redirectURI: window.location.origin + window.location.pathname,
      usePopup: true
    });
    AppleID.auth.signIn()
      .then((response) => {
        // Apple only returns user info on the very first sign-in
        // Store it in localStorage so we have it for future logins
        let name = 'Apple User';
        let email = '';
        if (response.user) {
          const fn = response.user.name?.firstName || '';
          const ln = response.user.name?.lastName || '';
          name = (fn + ' ' + ln).trim() || 'Apple User';
          email = response.user.email || '';
          // Persist name for future logins (Apple only sends it once)
          try { localStorage.setItem('pd_apple_name', name); } catch(e) {}
          try { localStorage.setItem('pd_apple_email', email); } catch(e) {}
        } else {
          // Returning user — reuse stored name if available
          try { name = localStorage.getItem('pd_apple_name') || 'Apple User'; } catch(e) {}
          try { email = localStorage.getItem('pd_apple_email') || ''; } catch(e) {}
        }
        this._handleOAuthSignIn(name, email);
      })
      .catch((err) => {
        if (err?.error !== 'popup_closed_by_user' && err?.error !== 'user_cancelled_authorize') {
          console.error('[Pour Decisions] Apple sign-in error:', err);
          alert('Apple Sign-In failed. Please try again.');
        }
      });
  }

  signIn(){
    this.setState(s => {
      const name = (s.authName || '').trim() || 'Maya R.';
      const email = (s.authEmail || '').trim() || 'maya@pourdecisions.co';
      const user = { name, initial: name[0].toUpperCase(), email };
      this._sv('pd_signedIn', true);
      this._sv('pd_user', user);
      return { signedIn:true, prev:'auth', screen:'home', authName:'', authEmail:'', user };
    });
  }
  signOut(){
    this._sv('pd_signedIn', false);
    this._sv('pd_cart', []);
    this.setState({ signedIn:false, screen:'auth', cart:[] });
  }
  openItem(it){ this.setState(s => ({ prev: s.screen, screen:'detail', activeId: it.id, qty: 1 })); }

  addToCart(it, q, free){
    q = q || 1;
    this.setState(s => {
      const cart = s.cart.slice();
      const ex = cart.find(c => c.id === it.id && !!c.free === !!free);
      if (ex) ex.qty += q; else cart.push({ id: it.id, qty: q, free: !!free });
      return { cart };
    });
  }
  changeQtyAt(i, d){
    this.setState(s => {
      let cart = s.cart.map((c, j) => j === i ? { ...c, qty: c.qty + d } : c).filter(c => c.qty > 0);
      return { cart };
    });
  }

  cartDetailed(){ return this.state.cart.map(c => { const m = this.MENU.find(m => m.id === c.id); return { ...m, qty: c.qty, free: c.free, price: c.free ? 0 : m.price }; }); }
  subtotal(){ return this.cartDetailed().reduce((a, c) => a + c.price * c.qty, 0); }

  spin(){
    if (this.state.spinning) return;
    const n = this.WHEEL.length, seg = 360 / n;
    const winner = Math.floor(Math.random() * n);
    const cur = this.state.rotation;
    const mod = ((cur % 360) + 360) % 360;
    const desired = ((360 - winner * seg) % 360 + 360) % 360;
    const delta = (desired - mod + 360) % 360;
    const rotation = cur + 360 * 5 + delta;
    this.setState({ spinning: true, wonId: null, rotation });
    setTimeout(() => {
      const wonId = this.WHEEL[winner];
      const spinRecord = { date: new Date().toISOString(), result: wonId === 'lose' ? 'lose' : 'win', wonId };
      this.setState(s => {
        const monthlySpins = [...(s.monthlySpins || []), spinRecord];
        this._sv('pd_monthly_spins', monthlySpins);
        return { spinning: false, wonId, monthlySpins };
      });
    }, 4300);
  }

  botReply(q){
    q = q.toLowerCase();
    if (/green|detox|healthy|clean/.test(q)) return "Go for the Green Machine 🥬 — kale, spinach and apple. Cleanest pour on the menu at 120 cal.";
    if (/energy|morning|wake|tired/.test(q)) return "Start with a Ginger Shot 🫚 then chase it with Citrus Sunrise 🍊. That combo will wake anyone up.";
    if (/sweet|treat|dessert/.test(q)) return "Berry Bloom 🍓 or the Açaí Bowl 🍇 — both taste like dessert but keep it real.";
    if (/tropic|beach|vacation|mango|pineapple/.test(q)) return "Tropic Thunder 🥭 is your beach in a cup — mango, pineapple and coconut water.";
    if (/cheap|budget|affordable|low.?cal/.test(q)) return "Watermelon Wave 🍉 — just $8 and 90 calories. Hard to beat.";
    if (/panini|sandwich|lunch|filling|hungry|food|eat/.test(q)) return "The Pesto Chicken Panini 🥪 with a cup of Carrot-Ginger Soup 🍲 is the coziest lunch on the menu.";
    if (/soup/.test(q)) return "Carrot-Ginger Soup 🍲 — velvety, warming and light. Tomato Basil 🍅 if you're a classicist.";
    if (/coffee|latte|matcha|tea|caffeine/.test(q)) return "Cold Brew ☕ for a clean kick, or a Matcha Latte 🍵 for calm, focused energy.";
    if (/breakfast|morning meal|oatmeal|toast/.test(q)) return "Sunrise Oatmeal 🥣 or Avocado Toast 🥑 — both fuel you past lunch without the crash.";
    if (/recommend|best|popular|what should/.test(q)) return "Our #1 pour is the Green Machine 🥬. But if you want a crowd-pleaser, Berry Bloom 🍓 never misses.";
    return "Ooh, good question! Tell me — are you after something energizing, sweet, or light and refreshing? I'll pour you the perfect match. 🍹";
  }
  submit(text){
    if (this.state.typing) return;
    const convo = this.state.pina.concat([{ role:'user', text }]);
    this.setState({ pina: convo, pinaInput:'', typing:true });
    this.askPina(convo, text);
  }
  async askPina(convo, lastText){
    const menuStr = this.MENU.map(m => `${m.name} (${m.cat}, $${m.price}, ${m.cal} cal): ${m.ingredients}`).join('\n');
    try {
      let messages = convo.map(m => ({ role: m.role === 'user' ? 'user' : 'assistant', content: m.text }));
      while (messages.length && messages[0].role === 'assistant') messages.shift();
      const reply = await window.claude.complete({
        system: `You are Piña 🍍, the upbeat, friendly juice guide for Pour Decisions, a colorful juice bar in Albany, NY. Only recommend drinks from THIS menu. Keep every reply to 1–3 short, warm sentences with a fruity emoji or two. Write in plain text only — never use markdown, asterisks, or bold. If asked something off-topic, gently steer back to juice.\n\nMENU:\n${menuStr}`,
        messages,
        max_tokens: 300
      });
      const text = (reply || '').trim() || "Hmm, my blender jammed 🍹 — ask me again?";
      this.setState(s => ({ pina: s.pina.concat([{ role:'bot', text }]), typing:false }));
    } catch (e) {
      this.setState(s => ({ pina: s.pina.concat([{ role:'bot', text: this.botReply(lastText || '') }]), typing:false }));
    }
  }
  sendPina(){ const t = this.state.pinaInput.trim(); if (t) this.submit(t); }

  placeOrderNow(){
    const sub = this.subtotal();
    const earned = Math.max(10, Math.round(sub * 10));
    this.setState(s => {
      const newOrderNo = s.orderNo + 1;
      const today = new Date().toISOString().slice(0,10);
      const items = this.cartDetailed().map(ci => ({ name: ci.name, qty: ci.qty }));
      const newOrder = { id: newOrderNo, date: today, items, total: Math.round(sub*100)/100, points: earned };
      const orders = [newOrder, ...s.orders];
      const newPoints = s.points + earned;
      const newFilled = Math.min(9, s.filled + 1);
      this._sv('pd_orders', orders);
      this._sv('pd_points', newPoints);
      this._sv('pd_filled', newFilled);
      this._sv('pd_orderNo', newOrderNo);
      this._sv('pd_cart', []);
      return { prev:'checkout', screen:'confirm', orderNo: newOrderNo, cart:[], points: newPoints, filled: newFilled, orders };
    });
  }

  doCheckout(){
    const S = this.state;
    const payOpts = [
      { id:'apple', label:'Apple Pay' },
      { id:'cash', label:'Cash App Pay' },
      { id:'card', label:'Card ···· 4827' },
      { id:'points', label:'Pour Pass Points' }
    ];
    const sel = payOpts[S.selectedPayment || 0];
    if (sel && sel.id === 'apple' && window.PaymentRequest) {
      try {
        const totalAmt = String(Math.round((this.subtotal()*1.08)*100)/100);
        const details = { total:{ label:'Pour Decisions', amount:{ currency:'USD', value: totalAmt } } };
        const req = new PaymentRequest([{ supportedMethods:'https://apple.com/apple-pay', data:{ version:3, merchantIdentifier:'merchant.com.pourdecisions', merchantCapabilities:['supports3DS'], supportedNetworks:['visa','masterCard','amex'], countryCode:'US' } }], details);
        req.show().then(() => this.placeOrderNow()).catch(() => this.placeOrderNow());
        return;
      } catch(e) {}
    }
    this.placeOrderNow();
  }

  rsvpEvent(id){
    this.setState(s => {
      const events = s.events.map(e => e.id === id ? { ...e, rsvpd: !e.rsvpd } : e);
      this._sv('pd_events', events);
      return { events };
    });
  }

  submitRental(){
    const s = this.state;
    if (!s.rentalName.trim() || !s.rentalEmail.trim() || !s.rentalDate) return;
    this.setState({ rentalSent: true });
  }

  adminSignIn(){
    const s = this.state;
    if (s.adminEmail === 'admin@pourdecisions.com' && s.adminPassword === 'PourAdmin2026!') {
      this.setState({ adminSignedIn: true, adminLoginError: '' });
    } else {
      this.setState({ adminLoginError: 'Invalid credentials. Try again.' });
    }
  }

  deleteAdminEvent(id){
    this.setState(s => {
      const events = s.events.filter(e => e.id !== id);
      this._sv('pd_events', events);
      return { events };
    });
  }

  toggleVenueSlot(id){
    this.setState(s => {
      const venueSlots = s.venueSlots.map(v => v.id === id ? { ...v, status: v.status === 'available' ? 'booked' : 'available' } : v);
      this._sv('pd_venue', venueSlots);
      return { venueSlots };
    });
  }

  saveAdminEvent(){
    const s = this.state;
    const f = s.adminEventForm;
    if (!f.title.trim() || !f.date) return;
    const newEv = { id: Date.now(), title:f.title, date:f.date, time:f.time, desc:f.desc, price:parseFloat(f.price)||0, emoji:f.emoji||'🥤', rsvpd:false };
    this.setState(st => {
      const events = [newEv, ...st.events];
      this._sv('pd_events', events);
      return { events, showAdminEventForm: false, adminEventForm:{ title:'', date:'', time:'', desc:'', price:'0', emoji:'🥤' } };
    });
  }

  claimPrize(id){
    this.setState(s => {
      const prize = s.prizes.find(p => p.id === id);
      if (!prize || prize.claimed) return {};
      const item = this.MENU.find(m => m.id === prize.itemId);
      if (item) this.addToCart(item, 1, true);
      const prizes = s.prizes.map(p => p.id === id ? { ...p, claimed: true } : p);
      this._sv('pd_prizes', prizes);
      return { prizes };
    });
    this.go('cart');
  }

  renderVals(){
    const S = this.state;
    const active = this.MENU.find(m => m.id === S.activeId) || this.MENU[0];
    const cat = this.props.menuCategory ?? '__none';
    const activeCat = (cat !== '__none' && this.CATS.includes(cat)) ? cat : (S.cat || 'All');
    const menu = this.MENU.filter(m => activeCat === 'All' || m.kind === activeCat)
      .slice().sort((a, b) => this.CATS.indexOf(a.kind) - this.CATS.indexOf(b.kind));
    const sub = this.subtotal();
    const tax = sub * 0.08;
    const total = sub + tax;
    const cartCount = S.cart.reduce((a, c) => a + c.qty, 0);
    const filled = S.filled;
    const remaining = Math.max(0, 9 - filled);

    const nav = [
      { key:'home', icon:'🏠', label:'Home' },
      { key:'menu', icon:'🥗', label:'Menu' },
      { key:'cart', icon:'🧺', label:'Order' },
      { key:'events', icon:'📅', label:'Events' },
      { key:'account', icon:'🙂', label:'You' }
    ];
    const activeTab = ({ detail:'menu', checkout:'cart', confirm:'cart', notifications:'home', pina:'home', prizes:'account', admin:'account', pass:'account' })[S.screen] || S.screen;

    const cardFields = it => ({
      ...it, priceLabel: this.fmt(it.price), calLabel: it.cal + ' cal',
      open: () => this.openItem(it), add: (e) => { if(e&&e.stopPropagation)e.stopPropagation(); this.addToCart(it); this.go('cart'); }
    });

    return {
      splashGrad: this.themeGrad(),
      stickerDisplay: (this.props.showFruitStickers ?? true) ? 'block' : 'none',

      isHome:S.screen==='home', isMenu:S.screen==='menu', isDetail:S.screen==='detail',
      isCart:S.screen==='cart', isCheckout:S.screen==='checkout', isConfirm:S.screen==='confirm',
      isPass:S.screen==='pass', isNotif:S.screen==='notifications', isAccount:S.screen==='account', isPina:S.screen==='pina',
      isWheel:S.screen==='wheel',
      isAuth:S.screen==='auth', showNav:!['auth','admin'].includes(S.screen),
      showPinaFab: !['pina','confirm','wheel','cart','checkout','auth','prizes','admin'].includes(S.screen),
      userEmail:S.user ? (S.user.email || '') : '',
      authMode:S.authMode, authModeIn:S.authMode==='in', authModeUp:S.authMode==='up',
      authTitle:S.authMode==='in'?'Welcome back':'Join the club',
      authSub:S.authMode==='in'?'Sign in to reorder, earn points and spin the wheel.':'Create an account to save your pours, points and payment.',
      authCta:S.authMode==='in'?'Sign in':'Create account',
      authToggleText:S.authMode==='in'?"New here? Create an account":'Already have an account? Sign in',
      authName:S.authName, authEmail:S.authEmail,
      onAuthName:(e)=>this.setState({authName:e.target.value}),
      onAuthEmail:(e)=>this.setState({authEmail:e.target.value}),
      toggleAuthMode:()=>this.setState(s=>({authMode:s.authMode==='in'?'up':'in'})),
      signIn:()=>this.signIn(), signOut:()=>this.signOut(),
      doGoogleSignIn:()=>this.doGoogleSignIn(),
      doAppleSignIn:()=>this.doAppleSignIn(),

      goHome:()=>this.go('home'), goMenu:()=>this.go('menu'), goCart:()=>this.go('cart'),
      goCheckout:()=>this.go('checkout'), goPass:()=>this.go('pass'), goNotif:()=>this.go('notifications'),
      goPina:()=>this.go('pina'), goWheel:()=>this.go('wheel'), back:()=>this.go(S.prev || 'home'),

      wheelTransform:'rotate(' + S.rotation + 'deg)',
      spinning:S.spinning, spin:()=>this.spin(),
      spinLabel: S.spinning ? '···' : 'SPIN',
      won: !!S.wonId && S.screen==='wheel',
      wonItem: (()=>{ const wId = (S.wonId && S.wonId !== 'lose') ? S.wonId : null; const w = wId ? (this.MENU.find(m=>m.id===wId)||this.MENU[0]) : this.MENU[0]; return { name:w.name, emoji:w.emoji, cat:w.cat, grad:w.grad }; })(),
      claimFree:()=>{
        const w=this.MENU.find(m=>m.id===S.wonId);
        if(w){ this.addToCart(w,1,true); }
        const prize = { id:Date.now(), itemId:S.wonId, name:w?w.name:'Prize', emoji:w?w.emoji:'🏆', cat:w?w.cat:'Juice', wonDate:new Date().toISOString().slice(0,10), claimed:true };
        this.setState(st=>{ const prizes=[...st.prizes,prize]; this._sv('pd_prizes',prizes); return {prizes,wonId:null}; });
        this.go('cart');
      },
      dismissWin:()=>{
        const w=this.MENU.find(m=>m.id===S.wonId);
        const prize = { id:Date.now(), itemId:S.wonId, name:w?w.name:'Prize', emoji:w?w.emoji:'🏆', cat:w?w.cat:'Juice', wonDate:new Date().toISOString().slice(0,10), claimed:false };
        this.setState(st=>{ const prizes=[...st.prizes,prize]; this._sv('pd_prizes',prizes); return {prizes,wonId:null}; });
      },
      toggleTheme:()=>{ const o=['Sunset','Citrus','Berry']; this.setState(s=>({theme:o[(o.indexOf(s.theme)+1)%3]})); },

      hasCart: cartCount>0, cartEmpty: cartCount===0, cartCount,
      subtotalLabel:this.fmt(sub), taxLabel:this.fmt(tax), totalLabel:this.fmt(total),

      featured: ['green','berry','tropic'].map(id => cardFields(this.MENU.find(m => m.id === id))),
      menu: menu.map(cardFields),

      homeChips: [
        { label:'🥬 Juices', bg:'var(--gold)', fg:'var(--teal-deep)', fw:800, cat:'Juices' },
        { label:'🍓 Smoothies', bg:'rgba(255,255,255,.1)', fg:'#fff', fw:700, cat:'Smoothies' },
        { label:'🫚 Shots', bg:'rgba(255,255,255,.1)', fg:'#fff', fw:700, cat:'Shots' },
        { label:'🥣 Breakfast', bg:'rgba(255,255,255,.1)', fg:'#fff', fw:700, cat:'Breakfast' },
        { label:'🥪 Eats', bg:'rgba(255,255,255,.1)', fg:'#fff', fw:700, cat:'Eats' },
        { label:'☕ Coffee & Tea', bg:'rgba(255,255,255,.1)', fg:'#fff', fw:700, cat:'Coffee & Tea' }
      ].map(c => ({ ...c, go:()=>{ this.setState({cat:c.cat}); this.go('menu'); } })),

      categories: this.CATS.map(c => ({
        label:c, go:()=>this.setState({cat:c}),
        bg: c===activeCat ? 'var(--gold)' : 'rgba(255,255,255,.16)',
        fg: c===activeCat ? 'var(--teal-deep)' : '#fff'
      })),

      item: {
        ...active, calLabel: active.cal + ' cal',
        ingList: active.ingList || active.ingredients.split(' · '),
        benefits: this.BENEFITS[active.id] || [],
        macros: [
          { value: this.fmt(active.price), label:'Price' },
          { value: active.cal, label:'Calories' },
          { value: ({ 'Shots':'2oz', 'Coffee & Tea':'12oz', 'Bowls':'Bowl', 'Breakfast':'Plate', 'Eats':'Plate', 'Salads & Soup':'Plate' })[active.kind] || '16oz', label:'Size' }
        ]
      },
      qty:S.qty, incQty:()=>this.setState(s=>({qty:s.qty+1})), decQty:()=>this.setState(s=>({qty:Math.max(1,s.qty-1)})),
      addDetail:()=>{ this.addToCart(active, S.qty); this.go('cart'); },
      detailTotal:this.fmt(active.price * S.qty),

      cart: this.cartDetailed().map((ci, i) => ({
        ...ci, lineLabel: ci.free ? 'FREE' : this.fmt(ci.price * ci.qty),
        inc:()=>this.changeQtyAt(i, 1), dec:()=>this.changeQtyAt(i, -1)
      })),

      pickupOptions: [
        { title:'ASAP', sub:'~12 min', bg:'var(--gold)', border:'var(--gold)', select:()=>{} , active:true},
        { title:'Schedule', sub:'Pick a time', bg:'rgba(255,255,255,.05)', border:'rgba(255,255,255,.12)', select:()=>{} }
      ].map((p,i)=>({ ...p, bg: i===0?'rgba(232,181,71,.16)':'rgba(255,255,255,.05)', border: i===0?'var(--gold)':'rgba(255,255,255,.12)' })),
      payOptions: (() => {
        const opts = [
          { id:'apple', icon:'⬛', label:'Apple Pay' + (typeof window!=='undefined'&&window.ApplePaySession?' ✓':''), sel:S.selectedPayment===0 },
          { id:'cash', icon:'💚', label:'Cash App Pay', sel:S.selectedPayment===1 },
          { id:'card', icon:'💳', label:'Card ···· 4827', sel:S.selectedPayment===2 },
          { id:'points', icon:'🎟️', label:'Pour Pass (' + S.points + ' pts)', sel:S.selectedPayment===3 }
        ];
        return opts.map((pm,i) => ({ ...pm,
          select:()=>this.setState({selectedPayment:i}),
          bg: pm.sel?'rgba(232,181,71,.14)':'rgba(255,255,255,.04)',
          border: pm.sel?'var(--gold)':'rgba(255,255,255,.1)',
          dot: pm.sel?'var(--gold)':'rgba(255,255,255,.3)',
          dotFill: pm.sel?'var(--gold)':'transparent'
        }));
      })(),

      placeOrder:()=>this.doCheckout(),
      orderNo:S.orderNo, pointsEarned:Math.max(10, Math.round(sub*10)),

      passRemaining:remaining, passFilled:filled, passEmpty:9-filled,
      points:S.points, memberSince:'since ’24', ordersCount:23,
      stamps: Array.from({length:9}, (_,i)=>({ bg: i<filled ? 'var(--gold)' : 'rgba(255,255,255,.14)' })),
      rewards: [
        { emoji:'🥤', title:'Free 16oz juice', cost:900, grad:'linear-gradient(150deg,#E8426A,#C4284E)', ready:false },
        { emoji:'🫚', title:'Free wellness shot', cost:400, grad:'linear-gradient(150deg,#FFE27A,#E8B547)', ready:true },
        { emoji:'🍓', title:'$3 off any smoothie', cost:250, grad:'linear-gradient(150deg,#FF8FB8,#FF3D80)', ready:true }
      ].map(r=>({ ...r, btnLabel: S.points>=r.cost?'Redeem':'Locked', btnBg: S.points>=r.cost?'var(--gold)':'rgba(255,255,255,.1)', btnFg: S.points>=r.cost?'var(--teal-deep)':'rgba(255,255,255,.4)' })),

      notifications: [
        { emoji:'🎉', title:'Your Pour Pass leveled up', time:'2m', body:'You hit Gold! Enjoy double points every Friday this month.', grad:'linear-gradient(150deg,#FFE27A,#E8B547)', bg:'rgba(232,181,71,.1)', border:'rgba(232,181,71,.3)' },
        { emoji:'🍉', title:'New: Watermelon Wave', time:'1h', body:'Summer\'s lightest pour just dropped — 90 cal, three ingredients.', grad:'linear-gradient(150deg,#FF7A8A,#FF3D80)', bg:'rgba(255,255,255,.04)', border:'rgba(255,255,255,.08)' },
        { emoji:'⏰', title:'Order #4826 is ready', time:'3h', body:'Grab it at the Lark St pickup shelf — your name\'s on it.', grad:'linear-gradient(150deg,#22D3EE,#0EA5C4)', bg:'rgba(255,255,255,.04)', border:'rgba(255,255,255,.08)' },
        { emoji:'🥭', title:'Tropic Thunder, 20% off', time:'1d', body:'Beat the heat — today only, tap to order ahead.', grad:'linear-gradient(150deg,#FFD54D,#FF8A3D)', bg:'rgba(255,255,255,.04)', border:'rgba(255,255,255,.08)' }
      ],

      accountRows: [
        { icon:'🎡', label:'Daily prize spin', go:()=>this.go('wheel') },
        { icon:'📅', label:'Events & Classes', go:()=>this.go('events') },
        { icon:'🏆', label:'My Prizes', go:()=>this.go('prizes') },
        { icon:'🎟️', label:'Pour Pass', go:()=>this.go('pass') },
        { icon:'❤️', label:'Favorites', go:()=>this.go('menu') },
        { icon:'🔔', label:'Notifications', go:()=>this.go('notifications') },
        { icon:'💳', label:'Payment methods', go:()=>this.go('checkout') },
        { icon:'🔐', label:'Admin Panel', go:()=>this.go('admin') },
        { icon:'📸', label:'Instagram · @pourdecisions.albany', go:()=>window.open('https://instagram.com/pourdecisions.albany','_blank') },
        { icon:'⚙️', label:'Settings', go:()=>{} },
        { icon:'🚪', label:'Sign out', go:()=>this.signOut() }
      ],

      pinaMessages: S.pina.map(m => ({
        text:m.text, align: m.role==='user'?'flex-end':'flex-start',
        bg: m.role==='user'?'var(--gold)':'rgba(255,255,255,.08)',
        fg: m.role==='user'?'#12303C':'#fff',
        radius: m.role==='user'?'20px 20px 6px 20px':'20px 20px 20px 6px'
      })),
      typing:S.typing,
      pinaSuggestions: [
        { label:'Most energizing?' }, { label:'Something filling' }, { label:'Something sweet' }, { label:'What\'s popular?' }
      ].map(q => ({ ...q, ask:()=>this.submit(q.label) })),
      pinaInput:S.pinaInput,
      onPinaInput:(e)=>this.setState({pinaInput:e.target.value}),
      onPinaKey:(e)=>{ if(e.key==='Enter'){ e.preventDefault(); this.sendPina(); } },
      sendPina:()=>this.sendPina(),

      isEvents:S.screen==='events', isPrizes:S.screen==='prizes', isAdmin:S.screen==='admin',
      goEvents:()=>this.go('events'), goPrizes:()=>this.go('prizes'), goAdmin:()=>this.go('admin'),
      goAccount:()=>this.go('account'), goWheel2:()=>this.go('wheel'),

      // Account tabs
      accountTab:S.accountTab,
      isAccountOverview:S.accountTab==='overview',
      isAccountTransactions:S.accountTab==='transactions',
      isAccountPrizes:S.accountTab==='prizes',
      tabOverviewBg:S.accountTab==='overview'?'var(--gold)':'rgba(255,255,255,.08)',
      tabOverviewFg:S.accountTab==='overview'?'var(--teal-deep)':'rgba(255,255,255,.6)',
      tabTxBg:S.accountTab==='transactions'?'var(--gold)':'rgba(255,255,255,.08)',
      tabTxFg:S.accountTab==='transactions'?'var(--teal-deep)':'rgba(255,255,255,.6)',
      tabPrBg:S.accountTab==='prizes'?'var(--gold)':'rgba(255,255,255,.08)',
      tabPrFg:S.accountTab==='prizes'?'var(--teal-deep)':'rgba(255,255,255,.6)',
      setTabOverview:()=>this.setState({accountTab:'overview'}),
      setTabTransactions:()=>this.setState({accountTab:'transactions'}),
      setTabPrizes:()=>this.setState({accountTab:'prizes'}),

      // Order history
      orderHistory: S.orders.map(o => ({
        ...o,
        idLabel:'#' + o.id,
        dateLabel:(()=>{ try{ return new Date(o.date).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}); }catch(e){ return o.date; } })(),
        itemSummary: o.items.map(i=>i.qty+'× '+i.name).join(', '),
        totalLabel:'$'+o.total.toFixed(2),
        pointsLabel:'+'+o.points+' pts'
      })),
      hasOrders:S.orders.length>0, noOrders:S.orders.length===0,

      // Prizes
      userPrizes: S.prizes.map(p => ({
        ...p,
        wonDateLabel:(()=>{ try{ return new Date(p.wonDate).toLocaleDateString('en-US',{month:'short',day:'numeric'}); }catch(e){ return p.wonDate; } })(),
        statusLabel: p.claimed?'Claimed':'Unclaimed',
        statusBg: p.claimed?'rgba(163,230,53,.15)':'rgba(232,181,71,.15)',
        statusFg: p.claimed?'#A3E635':'var(--gold-glow)',
        isUnclaimed: !p.claimed,
        claimFn:()=>this.claimPrize(p.id)
      })),
      hasPrizes:S.prizes.length>0, noPrizes:S.prizes.length===0,

      // Events
      upcomingEvents: S.events.map(ev => ({
        ...ev,
        dateLabel:(()=>{ try{ return new Date(ev.date).toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'}); }catch(e){ return ev.date; } })(),
        priceLabel: ev.price===0?'Free':'$'+ev.price,
        rsvpLabel: ev.rsvpd?"RSVP'd ✓":'RSVP',
        rsvpBg: ev.rsvpd?'rgba(163,230,53,.15)':'var(--gold)',
        rsvpFg: ev.rsvpd?'#A3E635':'var(--teal-deep)',
        isRsvpd: ev.rsvpd,
        rsvpFn:()=>this.rsvpEvent(ev.id)
      })),
      hasEvents:S.events.length>0, noEvents:S.events.length===0,

      // Venue slots
      venueSlots: S.venueSlots.map(v => ({
        ...v,
        dateLabel:(()=>{ try{ return new Date(v.date).toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'}); }catch(e){ return v.date; } })(),
        priceLabel:'$'+v.price,
        statusLabel: v.status==='available'?'Available':'Booked',
        statusBg: v.status==='available'?'rgba(163,230,53,.15)':'rgba(255,61,128,.15)',
        statusFg: v.status==='available'?'#A3E635':'#FF3D80',
        isAvail: v.status==='available',
        inquireFn:()=>this.setState({rentalDate:v.date,rentalSent:false}),
        toggleFn:()=>this.toggleVenueSlot(v.id)
      })),

      // Rental form
      rentalName:S.rentalName, rentalEmail:S.rentalEmail, rentalDate:S.rentalDate, rentalNote:S.rentalNote,
      rentalSent:S.rentalSent,
      rentalFormReady:S.rentalName.trim().length>0&&S.rentalEmail.trim().length>0&&S.rentalDate.length>0,
      rentalNotSent:!S.rentalSent,
      onRentalName:(e)=>this.setState({rentalName:e.target.value}),
      onRentalEmail:(e)=>this.setState({rentalEmail:e.target.value}),
      onRentalDate:(e)=>this.setState({rentalDate:e.target.value}),
      onRentalNote:(e)=>this.setState({rentalNote:e.target.value}),
      submitRental:()=>this.submitRental(),

      // Admin
      adminSignedIn:S.adminSignedIn,
      adminIsLogin:!S.adminSignedIn,
      adminIsDash:S.adminSignedIn,
      adminEmail:S.adminEmail, adminPassword:S.adminPassword, adminLoginError:S.adminLoginError,
      onAdminEmail:(e)=>this.setState({adminEmail:e.target.value}),
      onAdminPassword:(e)=>this.setState({adminPassword:e.target.value}),
      doAdminSignIn:()=>this.adminSignIn(),
      doAdminSignOut:()=>this.setState({adminSignedIn:false,adminEmail:'',adminPassword:''}),
      adminTab:S.adminTab,
      isAdminDash:S.adminTab==='dashboard',
      isAdminEvents:S.adminTab==='events',
      isAdminVenue:S.adminTab==='venue',
      isAdminPrizes:S.adminTab==='prizes',
      isAdminOrders:S.adminTab==='orders',
      setAdminDash:()=>this.setState({adminTab:'dashboard'}),
      setAdminEvents:()=>this.setState({adminTab:'events'}),
      setAdminVenue:()=>this.setState({adminTab:'venue'}),
      setAdminPrizes:()=>this.setState({adminTab:'prizes'}),
      setAdminOrders:()=>this.setState({adminTab:'orders'}),
      showAdminEventForm:S.showAdminEventForm,
      adminEventForm:S.adminEventForm,
      onAdminEvTitle:(e)=>this.setState(st=>({adminEventForm:{...st.adminEventForm,title:e.target.value}})),
      onAdminEvDate:(e)=>this.setState(st=>({adminEventForm:{...st.adminEventForm,date:e.target.value}})),
      onAdminEvTime:(e)=>this.setState(st=>({adminEventForm:{...st.adminEventForm,time:e.target.value}})),
      onAdminEvDesc:(e)=>this.setState(st=>({adminEventForm:{...st.adminEventForm,desc:e.target.value}})),
      onAdminEvPrice:(e)=>this.setState(st=>({adminEventForm:{...st.adminEventForm,price:e.target.value}})),
      onAdminEvEmoji:(e)=>this.setState(st=>({adminEventForm:{...st.adminEventForm,emoji:e.target.value}})),
      saveAdminEvent:()=>this.saveAdminEvent(),
      cancelAdminEvent:()=>this.setState({showAdminEventForm:false}),
      showAddEventForm:()=>this.setState({showAdminEventForm:true,adminEventForm:{title:'',date:'',time:'',desc:'',price:'0',emoji:'🥤'}}),
      editAdminEvent:(ev)=>this.setState({showAdminEventForm:true,adminEventForm:{title:ev.title,date:ev.date,time:ev.time,desc:ev.desc,price:String(ev.price),emoji:ev.emoji}}),
      deleteAdminEvent:(id)=>this.deleteAdminEvent(id),
      toggleVenueSlot:(id)=>this.toggleVenueSlot(id),
      adminOrders: S.orders.map(o=>({...o,idLabel:'#'+o.id,itemSummary:o.items.map(i=>i.qty+'× '+i.name).join(', '),totalLabel:'$'+o.total.toFixed(2)})),
      adminPrizes: S.prizes.map(p=>({...p,statusLabel:p.claimed?'Claimed':'Unclaimed',statusBg:p.claimed?'rgba(163,230,53,.2)':'rgba(232,181,71,.2)',statusFg:p.claimed?'#A3E635':'var(--gold-glow)'})),
      adminEvents: S.events.map(ev=>({...ev,priceLabel:ev.price===0?'Free':'$'+ev.price,deleteAdminEvent:()=>this.deleteAdminEvent(ev.id)})),
      adminVenue: S.venueSlots.map(v=>({...v,toggleFn:()=>this.toggleVenueSlot(v.id)})),
      adminTotalOrders:S.orders.length,
      adminUnclaimedPrizes:S.prizes.filter(p=>!p.claimed).length,
      adminTotalEvents:S.events.length,

      navItems: nav.map(n => ({
        icon:n.icon, label:n.label, go:()=>this.go(n.key),
        color: activeTab===n.key ? 'var(--gold)' : 'rgba(255,255,255,.5)',
        weight: activeTab===n.key ? 800 : 700
      })),

      // Desktop sidebar nav
      sidebarNav: nav.map(n => ({
        icon: n.icon, label: n.label, go: ()=>this.go(n.key),
        activeBg: activeTab===n.key ? 'rgba(232,181,71,.15)' : 'transparent',
        color: activeTab===n.key ? 'var(--gold)' : 'rgba(255,255,255,.65)',
        weight: activeTab===n.key ? 800 : 600
      })),
      userInitial: S.user ? (S.user.initial || (S.user.name ? S.user.name[0].toUpperCase() : 'G')) : 'G',
      userName: S.user ? (S.user.name || 'Guest') : 'Guest',
      signedIn: S.signedIn,

      // PWA install banner
      showInstallBanner: S.showInstallBanner && !S.installDismissed,
      doInstall: () => {
        if (S.installPrompt) {
          S.installPrompt.prompt();
          S.installPrompt.userChoice.then(() => this.setState({ showInstallBanner: false, installPrompt: null }));
        }
      },
      dismissInstall: () => {
        this._sv('pd_install_dismissed', true);
        this.setState({ showInstallBanner: false, installDismissed: true });
      },

      // Sign-in CTA
      showSignInCta: !S.signedIn,
      goAuth: () => this.go('auth'),

      // Wheel — win/lose states
      showWinClaim: S.signedIn && !!S.wonId && S.wonId !== 'lose' && S.screen === 'wheel',
      showWinSignInPrompt: !S.signedIn && !!S.wonId && S.wonId !== 'lose' && S.screen === 'wheel',
      showLoseResult: S.wonId === 'lose' && S.screen === 'wheel',
      isLoseResult: S.wonId === 'lose',
      isWinResult: !!S.wonId && S.wonId !== 'lose',
      dismissLose: () => this.setState({ wonId: null }),
      signInFromWheel: () => { this.setState({ wonId: null }); this.go('auth'); },
      wonName: S.wonId && S.wonId !== 'lose' ? ((this.MENU.find(m=>m.id===S.wonId)||{name:'a prize'}).name) : '',
      wonEmoji: S.wonId && S.wonId !== 'lose' ? ((this.MENU.find(m=>m.id===S.wonId)||{emoji:'🎁'}).emoji) : '😔',

      // Events calendar
      eventsView: S.eventsView || 'list',
      isEventsListView: (S.eventsView || 'list') === 'list',
      isEventsCalView: S.eventsView === 'calendar',
      setEventsListView: () => this.setState({ eventsView: 'list' }),
      setEventsCalView: () => this.setState({ eventsView: 'calendar' }),
      eventsListViewBg: (S.eventsView||'list')==='list' ? 'var(--gold)' : 'rgba(255,255,255,.1)',
      eventsListViewFg: (S.eventsView||'list')==='list' ? 'var(--teal-deep)' : '#fff',
      eventsCalViewBg: S.eventsView==='calendar' ? 'var(--gold)' : 'rgba(255,255,255,.1)',
      eventsCalViewFg: S.eventsView==='calendar' ? 'var(--teal-deep)' : '#fff',
      calendarMonthLabel: (()=>{ try{ return new Date().toLocaleDateString('en-US',{month:'long',year:'numeric'}); }catch(e){ return ''; } })(),
      calendarDays: (()=>{
        const now = new Date();
        const year = now.getFullYear();
        const month = now.getMonth();
        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month+1, 0).getDate();
        const eventDates = new Set((S.events||[]).map(ev => ev.date));
        const days = [];
        for (let i = 0; i < firstDay; i++) days.push({ label:'', empty:true, hasEvent:false, isToday:false });
        for (let d = 1; d <= daysInMonth; d++) {
          const dateStr = year+'-'+String(month+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');
          days.push({ label:String(d), empty:false, hasEvent:eventDates.has(dateStr), isToday:d===now.getDate() });
        }
        return days;
      })(),

      // Menu drinks/food split
      menuDrinks: menu.filter(m => ['Juices','Smoothies','Shots','Coffee & Tea','Bowls'].includes(m.kind)),
      menuFood: menu.filter(m => ['Breakfast','Eats','Salads & Soup'].includes(m.kind)),
      hasDrinkItems: menu.some(m => ['Juices','Smoothies','Shots','Coffee & Tea','Bowls'].includes(m.kind)),
      hasFoodItems: menu.some(m => ['Breakfast','Eats','Salads & Soup'].includes(m.kind))
    };
  }
}
</script>
<script>
// PWA install prompt handler
window.addEventListener('beforeinstallprompt', function(e) {
  e.preventDefault();
  var dismissed = false;
  try { dismissed = JSON.parse(localStorage.getItem('pd_install_dismissed') || 'false'); } catch(err) {}
  if (!dismissed) {
    setTimeout(function() {
      var comp = document.querySelector('x-dc') && document.querySelector('x-dc').__dcInstance;
      if (comp) comp.setState({ installPrompt: e, showInstallBanner: true });
    }, 3000);
  }
});
</script>
</body>
</html>
