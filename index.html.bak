<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pour Decisions — Cold-Pressed Juice · Albany NY</title>
<script src="./support.js"></script>

  <!-- ═══════════════════════════════════════════════════════════
       GOOGLE SIGN-IN (Google Identity Services)
       ─────────────────────────────────────────────────────────
       SETUP REQUIRED:
       1. Go to https://console.cloud.google.com/apis/credentials
       2. Create an OAuth 2.0 Client ID (Web application type)
       3. Add https://pourdecisionsjuicebar.com to Authorized JavaScript origins
       4. Replace YOUR_GOOGLE_CLIENT_ID below with your actual Client ID
  ═══════════════════════════════════════════════════════════ -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>

  <!-- ═══════════════════════════════════════════════════════════
       APPLE SIGN IN (Sign in with Apple JS)
       ─────────────────────────────────────────────────────────
       SETUP REQUIRED:
       1. Go to https://developer.apple.com/account/resources/identifiers
       2. Register a Services ID (not an App ID)
       3. Enable "Sign In with Apple" and add pourdecisionsjuicebar.com as domain
       4. Replace YOUR_APPLE_SERVICE_ID below with your actual Services ID
  ═══════════════════════════════════════════════════════════ -->
  <script src="https://appleid.cdn-apple.com/appleauth/static/jsapi/appleid/1/en_US/appleid.auth.js" async defer></script>

</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,900;1,9..144,600;1,9..144,900&amp;family=Manrope:wght@400;500;600;700;800&amp;family=Bebas+Neue&amp;display=swap" rel="stylesheet">
<style>
  :root{
    /* Pink / coral primary */
    --pink:#E8426A; --pink-deep:#C4284E; --pink-light:#F06080;
    --palm-shadow:rgba(180,20,55,.28);
    /* Navy backgrounds */
    --navy:#1C1F2E; --navy-mid:#252840; --navy-card:rgba(28,31,46,.85);
    /* Teal aliases → navy for compatibility */
    --teal:#1F4860; --teal-deep:#1C1F2E; --teal-ink:#1C1F2E; --teal-bright:#2BA7A0;
    --teal-mid:#252840; --teal-card:rgba(255,255,255,.07);
    /* Gold */
    --gold:#E8B547; --gold-deep:#C68F2C; --gold-glow:#FFD980;
    /* Misc */
    --cream:#FFF8EC; --paper:#FFFDF8;
    --orange:#FF6B35; --lime:#A3E635; --lime-deep:#65A30D;
    --cyan:#22D3EE; --purple:#7C3AED; --ink:#1A1A1A; --muted:#5E5E66;
    --f-display:'Fraunces',ui-serif,Georgia,serif; --f-body:'Manrope',system-ui,sans-serif;
    --f-num:'Bebas Neue',Impact,sans-serif;
  }
  *{box-sizing:border-box}
  .pdbody{margin:0;background:#EBE3D2;font-family:var(--f-body);color:var(--ink);-webkit-font-smoothing:antialiased}
  @keyframes bobY{50%{transform:translateY(-9px) rotate(var(--r,0deg))}}
  @keyframes bobYr{50%{transform:translateY(-7px) rotate(-6deg)}}
  @keyframes wobble{50%{transform:translateY(3px) scaleX(1.06)}}
  @keyframes pulseDot{50%{transform:scale(1.5)}}
  @keyframes floatIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  @keyframes popIn{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:none}}
  .noscroll::-webkit-scrollbar{display:none}
  .noscroll{scrollbar-width:none}
  .tap{cursor:pointer;transition:transform .12s ease,box-shadow .12s ease}
  .tap:active{transform:scale(.96)}
  html,body{margin:0;padding:0;height:100%;background:var(--pink)}
  .pd-app{width:100%;min-height:100dvh;background:var(--pink);position:relative;display:flex;flex-direction:column;overflow:hidden}
  .pd-sidebar{display:none}
  .pd-bottom-nav-wrap{position:relative;z-index:85}
  /* ── Hero base styles (all screen sizes) ───────────────── */
  .pd-hero-body{text-align:center;}
  .pd-hero-nav{position:relative;display:flex;align-items:center;min-height:72px;}
  .pd-hero-logo{position:absolute;left:50%;transform:translateX(-50%);}
  /* ── Site-wide consistency ──────────────────────────────── */
  .pd-section-title{font-family:var(--f-display);font-style:italic;font-weight:900;letter-spacing:-.025em;margin:0;}
  .pd-card-pad{padding:16px;border-radius:20px;}
  .pd-btn-cta{font-weight:800;font-size:15px;padding:14px 26px;border-radius:999px;border:0;cursor:pointer;}
  @media(min-width:1024px){.pd-card-pad{padding:24px;}}
  @media(min-width:768px) and (max-width:1023px){
    .pd-app{max-width:none}
    .pd-main-content-wrap{max-width:680px;margin:0 auto;width:100%}
  }
  @media(min-width:1024px){
    body{display:flex;background:var(--pink)}
    .pd-app{flex-direction:row;max-width:none;width:100vw;height:100dvh;overflow:hidden}
    .pd-sidebar{display:flex !important;flex-direction:column;width:220px;flex:0 0 220px;background:var(--navy);height:100dvh;position:sticky;top:0;border-right:1px solid rgba(255,255,255,.1);z-index:50;overflow-y:auto}
    .pd-bottom-nav-wrap{display:none !important}
    .pd-main-scroll{flex:1;overflow-y:auto;overflow-x:hidden;position:relative;height:100dvh}
    .pd-pina-fab{position:fixed !important;right:24px !important;bottom:24px !important}
    .menu-columns{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start}

    /* ── Hero desktop layout ─────────────────────────────────── */
    .pd-hero{
      min-height:72vh !important;
      padding:44px 80px 44px !important;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }
    .pd-hero-nav{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:20px;
      position:relative;
      z-index:2;
    }
    .pd-hero-body{
      flex:1;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      text-align:center;
      margin-top:0 !important;
      padding-top:24px;
      position:relative;
      z-index:2;
    }
    .pd-hero-title{
      font-size:clamp(48px,6vw,88px) !important;
      line-height:.9 !important;
    }
    .pd-hero-logo{
      height:76px !important;
      width:162px !important;
    }
    .pd-hero-cup{ display:none }
    /* Scale palm SVGs inside hero */
    .pd-hero .pd-palm-l{width:380px !important;left:-100px !important;bottom:-60px !important}
    .pd-hero .pd-palm-r{width:320px !important;right:-90px !important;bottom:-30px !important}
    /* Reposition floating fruit + veg to corners on desktop */
    .pd-fruit-orange{font-size:140px !important;top:6% !important;right:3% !important}
    .pd-fruit-strawberry{font-size:120px !important;top:6% !important;left:3% !important}
    .pd-fruit-kiwi{font-size:90px !important;bottom:14% !important;left:5% !important}
    .pd-veg-lemon{font-size:100px !important;bottom:10% !important;right:5% !important}
    .pd-veg-broccoli{font-size:80px !important;top:42% !important;left:2% !important}
    .pd-veg-carrot{font-size:75px !important;top:38% !important;right:2% !important}
  }
</style>
</helmet>

<div class="pdbody">

  <div class="pd-app noscroll">

      <!-- SIDEBAR — hidden on mobile via CSS -->
      <aside class="pd-sidebar">
        <!-- Logo -->
        <div style="padding:28px 20px 20px;border-bottom:1px solid rgba(255,255,255,.08);">
          <img src="assets/logo-clean-512.png" style="height:44px;width:auto;" alt="Pour Decisions">
          <div style="font-size:11px;color:rgba(255,255,255,.4);font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-top:6px;">275 Lark St · Albany NY</div>
        </div>
        <!-- Nav items (vertical) -->
        <nav style="flex:1;padding:16px 12px;display:flex;flex-direction:column;gap:4px;">
          <sc-for list="{{ sidebarNav }}" as="sn">
            <button onClick="{{ sn.go }}" class="tap" style="display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:14px;border:0;background:{{ sn.activeBg }};color:{{ sn.color }};font-weight:{{ sn.weight }};font-size:14px;text-align:left;width:100%;cursor:pointer;">
              <span style="font-size:20px;width:26px;text-align:center;">{{ sn.icon }}</span>
              <span style="flex:1;">{{ sn.label }}</span>
            </button>
          </sc-for>
        </nav>
        <!-- User info at bottom -->
        <sc-if value="{{ signedIn }}" hint-placeholder-val="{{ false }}">
        <div style="padding:16px;border-top:1px solid rgba(255,255,255,.08);">
          <div style="display:flex;align-items:center;gap:10px;">
            <div style="width:36px;height:36px;border-radius:50%;background:var(--gold);display:grid;place-items:center;font-weight:900;color:var(--navy);font-size:15px;">{{ userInitial }}</div>
            <div>
              <div style="font-weight:700;color:#fff;font-size:13px;">{{ userName }}</div>
              <div style="font-size:11px;color:var(--gold-glow);">{{ points }} pts</div>
            </div>
          </div>
        </div>
        </sc-if>
      </aside>

      <!-- MAIN CONTENT -->
      <div class="pd-main-scroll noscroll" style="flex:1;overflow-y:auto;overflow-x:hidden;position:relative;">

      <!-- SCROLL AREA -->
      <div class="noscroll" style="flex:1;overflow-y:auto;overflow-x:hidden;position:relative;">

        <!-- ===================== AUTH ===================== -->
        <sc-if value="{{ isAuth }}" hint-placeholder-val="{{ true }}">
        <div style="min-height:100dvh;display:flex;flex-direction:column;background:{{ splashGrad }};color:#fff;position:relative;overflow:hidden;animation:floatIn .35s ease both;">
          <svg viewBox="0 0 240 520" style="position:absolute;right:-58px;top:64px;width:225px;height:auto;"><g fill="rgba(0,0,0,.16)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
          <svg viewBox="0 0 240 520" style="position:absolute;left:-52px;top:150px;width:135px;height:auto;transform:scaleX(-1);"><g fill="rgba(0,0,0,.11)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
          <div style="position:absolute;top:70px;left:-10px;font-size:58px;animation:bobYr 7s ease-in-out infinite;filter:drop-shadow(0 10px 16px rgba(0,0,0,.25));">🍓</div>
          <div style="position:absolute;top:150px;right:-6px;font-size:66px;animation:bobY 6s ease-in-out infinite;--r:-10deg;filter:drop-shadow(0 10px 16px rgba(0,0,0,.25));">🍊</div>
          <div style="position:absolute;top:250px;left:30px;font-size:40px;animation:bobY 8s ease-in-out infinite;--r:12deg;">🥝</div>

          <div style="position:relative;z-index:2;padding:64px 24px 0;text-align:center;flex:0 0 auto;">
            <img src="assets/logo-clean-512.png" style="height:72px;width:auto;display:inline-block;filter:drop-shadow(0 4px 14px rgba(0,0,0,.35));" alt="Pour Decisions">
            <h2 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:44px;line-height:.92;letter-spacing:-.03em;margin:26px 0 0;text-shadow:0 4px 18px rgba(0,0,0,.22);">Juice o'clock<br>starts here.</h2>
          </div>

          <div style="margin-top:auto;background:var(--navy);border-radius:34px 34px 0 0;position:relative;z-index:3;padding:30px 24px 40px;box-shadow:0 -20px 50px rgba(0,0,0,.25);">
            <h3 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:28px;color:#fff;margin:0;letter-spacing:-.02em;">{{ authTitle }}</h3>
            <p style="color:rgba(255,255,255,.6);font-size:13.5px;line-height:1.5;margin:6px 0 22px;">{{ authSub }}</p>

            <sc-if value="{{ authModeUp }}" hint-placeholder-val="{{ false }}">
              <input value="{{ authName }}" onInput="{{ onAuthName }}" placeholder="Full name" style="width:100%;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:15px 18px;color:#fff;font-size:14px;font-family:var(--f-body);outline:none;margin-bottom:12px;">
            </sc-if>
            <input value="{{ authEmail }}" onInput="{{ onAuthEmail }}" placeholder="Email address" style="width:100%;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:15px 18px;color:#fff;font-size:14px;font-family:var(--f-body);outline:none;margin-bottom:12px;">
            <input type="password" placeholder="Password" style="width:100%;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:15px 18px;color:#fff;font-size:14px;font-family:var(--f-body);outline:none;margin-bottom:18px;">

            <button onClick="{{ signIn }}" class="tap" style="width:100%;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:16px;padding:17px;border-radius:99px;border:0;box-shadow:0 10px 24px rgba(232,181,71,.45);">{{ authCta }}</button>

            <div style="display:flex;align-items:center;gap:12px;margin:20px 0;"><span style="flex:1;height:1px;background:rgba(255,255,255,.12);"></span><span style="font-size:11px;color:rgba(255,255,255,.4);font-weight:700;letter-spacing:.08em;">OR</span><span style="flex:1;height:1px;background:rgba(255,255,255,.12);"></span></div>

            <div style="display:flex;gap:10px;">
              <!-- Apple Sign In — real OAuth via AppleID.auth.signIn() -->
              <button onClick="{{ doAppleSignIn }}" class="tap" style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;background:#000;border:1px solid rgba(255,255,255,.2);border-radius:16px;padding:14px;color:#fff;font-weight:700;font-size:13px;">
                <svg width="16" height="19" viewBox="0 0 814 1000" fill="#fff"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105.2-58.4-155.5-127.4C46 373.5 38.4 342.7 38.4 342.3 38.4 232.8 107.4 106 279.3 106c75.3 0 139.5 50.1 184.9 50.1 43.4 0 113.4-52.3 198.9-52.3zm-115.3-107.7C614.9 174.5 591 135.1 591 95.6c0-13.2 1.9-26.4 2.6-38.3 63.4-2.6 139.3 35.8 184.3 96.3 41.4 53.2 54.9 112.9 54.9 163.2 0 11.5-2.6 23-2.6 38.3-67.9-2.6-148.1-44.3-148.4-121.9z"></path></svg>
                Sign in with Apple
              </button>
              <!-- Google Sign In — real OAuth via Google Identity Services -->
              <button onClick="{{ doGoogleSignIn }}" class="tap" style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;background:#fff;border:1px solid rgba(255,255,255,.2);border-radius:16px;padding:14px;color:#1f2937;font-weight:700;font-size:13px;">
                <svg width="17" height="17" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                Sign in with Google
              </button>
            </div>

            <div onClick="{{ toggleAuthMode }}" class="tap" style="text-align:center;color:var(--gold-glow);font-weight:700;font-size:13.5px;margin-top:22px;">{{ authToggleText }}</div>
          </div>
        </div>
        </sc-if>

        <!-- ===================== HOME ===================== -->
        <sc-if value="{{ isHome }}" hint-placeholder-val="{{ true }}">
        <div style="animation:floatIn .35s ease both;">
          <div class="pd-hero" style="position:relative;min-height:428px;overflow:hidden;padding:44px 20px 34px;color:#fff;background:{{ splashGrad }};">
            <svg class="pd-palm-l" viewBox="0 0 240 520" style="position:absolute;left:-48px;bottom:-36px;width:215px;height:auto;"><g fill="rgba(0,0,0,.16)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <svg class="pd-palm-r" viewBox="0 0 240 520" style="position:absolute;right:-58px;bottom:-16px;width:150px;height:auto;transform:scaleX(-1);"><g fill="rgba(0,0,0,.11)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <div class="pd-fruit-orange" style="position:absolute;top:98px;right:-6px;font-size:76px;animation:bobY 6s ease-in-out infinite;--r:-10deg;filter:drop-shadow(0 10px 16px rgba(0,0,0,.25));display:{{ stickerDisplay }};">🍊</div>
            <div class="pd-fruit-strawberry" style="position:absolute;top:212px;left:-10px;font-size:62px;animation:bobYr 7s ease-in-out infinite;filter:drop-shadow(0 10px 16px rgba(0,0,0,.25));display:{{ stickerDisplay }};">🍓</div>
            <div class="pd-fruit-kiwi" style="position:absolute;bottom:118px;right:40px;font-size:44px;animation:bobY 8s ease-in-out infinite;--r:12deg;filter:drop-shadow(0 8px 12px rgba(0,0,0,.2));display:{{ stickerDisplay }};">🥝</div>
            <div class="pd-veg-lemon" style="position:absolute;bottom:60px;left:28px;font-size:52px;animation:bobYr 10s ease-in-out infinite;filter:drop-shadow(0 8px 12px rgba(0,0,0,.18));display:{{ stickerDisplay }};">🍋</div>
            <div class="pd-veg-broccoli" style="position:absolute;top:80px;left:18px;font-size:36px;animation:bobY 12s ease-in-out infinite;--r:8deg;filter:drop-shadow(0 6px 10px rgba(0,0,0,.16));display:{{ stickerDisplay }};">🥦</div>
            <div class="pd-veg-carrot" style="position:absolute;top:72px;right:26px;font-size:34px;animation:bobYr 9s ease-in-out infinite;filter:drop-shadow(0 6px 10px rgba(0,0,0,.16));display:{{ stickerDisplay }};">🥕</div>
            <!-- gradient fade into navy panel below -->
            <div style="position:absolute;bottom:0;left:0;right:0;height:56px;background:linear-gradient(to bottom,transparent,rgba(28,31,46,.55));z-index:1;pointer-events:none;"></div>

            <div class="pd-hero-nav" style="display:flex;align-items:center;gap:10px;position:relative;z-index:2;">
              <button onClick="{{ toggleTheme }}" class="tap" style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.22);border:0;display:grid;place-items:center;backdrop-filter:blur(4px);">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M3 12h18M3 18h18" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path></svg>
              </button>
              <img class="pd-hero-logo" src="assets/logo-clean-512.png" style="height:64px;width:136px;display:block;filter:drop-shadow(0 4px 14px rgba(0,0,0,.38))" alt="Pour Decisions">
              <span style="margin-left:auto;display:flex;gap:8px;">
                <button onClick="{{ goNotif }}" class="tap" style="position:relative;width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.22);border:0;display:grid;place-items:center;backdrop-filter:blur(4px);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  <span style="position:absolute;top:-2px;right:-2px;width:11px;height:11px;border-radius:50%;background:var(--lime);border:2px solid var(--orange);"></span>
                </button>
                <button onClick="{{ goCart }}" class="tap" style="position:relative;width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.22);border:0;display:grid;place-items:center;backdrop-filter:blur(4px);">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M3 4h2l2.5 12.5A2 2 0 0 0 9.5 18h8.5l2-9H6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="10" cy="21" r="1.4" fill="#fff"></circle><circle cx="17" cy="21" r="1.4" fill="#fff"></circle></svg>
                  <sc-if value="{{ hasCart }}" hint-placeholder-val="{{ true }}"><span style="position:absolute;top:-3px;right:-3px;background:var(--lime);color:var(--teal-deep);font-size:11px;font-weight:800;min-width:19px;height:19px;border-radius:99px;display:grid;place-items:center;border:2px solid var(--orange);">{{ cartCount }}</span></sc-if>
                </button>
              </span>
            </div>

            <div class="pd-hero-body" style="position:relative;z-index:2;margin-top:50px;text-align:center;">
              <span style="font-family:var(--f-num);letter-spacing:.22em;font-size:14px;color:#fff;background:rgba(0,0,0,.16);padding:4px 12px;border-radius:99px;">FRESH TODAY · ALBANY</span>
              <h2 class="pd-hero-title" style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:52px;line-height:.9;letter-spacing:-.035em;margin:16px 0 0;text-shadow:0 4px 18px rgba(0,0,0,.22);">Juice<br>o'clock.</h2>
              <button onClick="{{ goMenu }}" class="tap" style="margin-top:20px;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:15px;padding:14px 26px;border-radius:999px;border:0;box-shadow:0 10px 24px rgba(232,181,71,.5);">Order ahead →</button>
            </div>

            <div class="pd-hero-cup" style="position:absolute;right:22px;bottom:26px;z-index:2;">
              <div style="width:96px;height:132px;border:3px solid #fff;border-top:0;border-radius:8px 8px 26px 26px;overflow:hidden;background:rgba(255,255,255,.12);position:relative;box-shadow:0 12px 26px rgba(0,0,0,.2);">
                <div style="position:absolute;left:0;right:0;bottom:0;height:74%;background:linear-gradient(180deg,#FFE27A,#FF8A3D 60%,#FF3D80);">
                  <div style="position:absolute;top:-7px;left:0;right:0;height:13px;background:var(--gold-glow);border-radius:50%;animation:wobble 2.6s ease-in-out infinite;"></div>
                </div>
                <div style="position:absolute;top:-20px;left:22px;width:8px;height:44px;background:#fff;border-radius:99px;transform:rotate(12deg);"></div>
              </div>
            </div>
          </div>

          <div style="background:var(--navy);border-radius:28px 28px 0 0;margin-top:-32px;position:relative;z-index:3;padding:28px 0 0;">
            <div class="noscroll" style="display:flex;gap:9px;overflow-x:auto;padding:0 18px 6px;">
              <sc-for list="{{ homeChips }}" as="c" hint-placeholder-count="4">
                <span onClick="{{ c.go }}" class="tap" style="flex:0 0 auto;background:{{ c.bg }};color:{{ c.fg }};font-weight:{{ c.fw }};font-size:13px;padding:10px 18px;border-radius:99px;display:inline-flex;align-items:center;gap:6px;">{{ c.label }}</span>
              </sc-for>
            </div>

            <div style="padding:20px 16px 6px;">
              <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:12px;">
                <h3 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:26px;color:#fff;margin:0;letter-spacing:-.02em;">Today's pours</h3>
                <span onClick="{{ goMenu }}" class="tap" style="font-family:var(--f-num);letter-spacing:.14em;font-size:12px;color:var(--gold-glow);">SEE ALL</span>
              </div>
              <div class="noscroll" style="display:flex;gap:14px;overflow-x:auto;padding-bottom:4px;">
                <sc-for list="{{ featured }}" as="it" hint-placeholder-count="3">
                  <div onClick="{{ it.open }}" class="tap" style="flex:0 0 210px;border-radius:24px;padding:18px;min-height:250px;display:flex;flex-direction:column;justify-content:space-between;background:{{ it.grad }};color:{{ it.text }};position:relative;overflow:hidden;box-shadow:0 14px 30px {{ it.shadow }};">
                    <div style="position:absolute;top:-20px;right:-14px;font-size:96px;opacity:.32;">{{ it.emoji }}</div>
                    <span style="align-self:flex-start;background:{{ it.tagBg }};color:{{ it.tagFg }};font-size:10px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;padding:4px 10px;border-radius:99px;position:relative;">{{ it.cat }}</span>
                    <div style="position:relative;">
                      <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:24px;line-height:.95;">{{ it.name }}</div>
                      <div style="display:flex;align-items:center;gap:8px;margin-top:6px;"><span style="font-family:var(--f-num);font-size:30px;">{{ it.priceLabel }}</span><span style="font-size:11px;font-weight:700;opacity:.78;">{{ it.calLabel }}</span></div>
                    </div>
                  </div>
                </sc-for>
              </div>
            </div>

            <sc-if value="{{ showInstallBanner }}" hint-placeholder-val="{{ false }}">
            <div style="margin:20px 16px 0;background:linear-gradient(135deg,rgba(28,31,46,.95),rgba(37,40,64,.95));border:1px solid rgba(232,181,71,.3);border-radius:20px;padding:16px;display:flex;gap:14px;align-items:center;">
              <div style="font-size:36px;flex:0 0 auto;">📲</div>
              <div style="flex:1;min-width:0;">
                <div style="font-weight:800;color:#fff;font-size:14px;margin-bottom:3px;">Add to Home Screen</div>
                <div style="font-size:12px;color:rgba(255,255,255,.65);line-height:1.4;">Save Pour Decisions for quick ordering — no browser needed.</div>
              </div>
              <div style="display:flex;flex-direction:column;gap:6px;flex:0 0 auto;">
                <button onClick="{{ doInstall }}" class="tap" style="background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:12px;padding:8px 14px;border-radius:99px;border:0;white-space:nowrap;">Install</button>
                <button onClick="{{ dismissInstall }}" class="tap" style="background:rgba(255,255,255,.08);color:rgba(255,255,255,.6);font-weight:600;font-size:11px;padding:6px 10px;border-radius:99px;border:0;white-space:nowrap;">Not now</button>
              </div>
            </div>
            </sc-if>

            <div onClick="{{ goWheel }}" class="tap" style="margin:20px 16px 0;border-radius:26px;padding:22px;background:linear-gradient(135deg,#FF6B35,#FF3D80 55%,#7C3AED);color:#fff;position:relative;overflow:hidden;box-shadow:0 16px 34px rgba(255,61,128,.35);display:flex;align-items:center;gap:16px;">
              <div style="position:absolute;top:-16px;right:-10px;font-size:96px;opacity:.25;">🎡</div>
              <div style="flex:0 0 auto;width:60px;height:60px;border-radius:50%;background:rgba(255,255,255,.2);display:grid;place-items:center;font-size:34px;backdrop-filter:blur(4px);">🎡</div>
              <div style="position:relative;flex:1;">
                <div style="font-family:var(--f-num);letter-spacing:.18em;font-size:12px;color:var(--gold-glow);">FREE DAILY SPIN</div>
                <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:22px;line-height:1;margin:3px 0 2px;">Spin to win a free pour</div>
                <div style="font-size:12px;color:rgba(255,255,255,.85);font-weight:600;">Your spin's ready — tap to play →</div>
              </div>
            </div>

            <div onClick="{{ goPass }}" class="tap" style="margin:16px 16px 0;border-radius:26px;padding:26px 22px;background:linear-gradient(150deg,#E8426A,#C4284E);color:#fff;position:relative;overflow:hidden;box-shadow:0 16px 34px rgba(232,66,106,.3);">
              <div style="position:absolute;bottom:-30px;right:-10px;font-size:120px;opacity:.28;">🥤</div>
              <div style="font-family:var(--f-num);letter-spacing:.18em;font-size:12px;color:rgba(255,255,255,.85);">POUR PASS</div>
              <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:26px;line-height:.98;margin:6px 0 12px;max-width:14ch;">{{ passRemaining }} pours from a free juice</div>
              <div style="display:flex;gap:5px;">
                <span style="flex:{{ passFilled }};height:9px;border-radius:99px;background:var(--teal-deep);"></span>
                <span style="flex:{{ passEmpty }};height:9px;border-radius:99px;background:rgba(255,255,255,.25);"></span>
              </div>
            </div>
            <sc-if value="{{ showSignInCta }}" hint-placeholder-val="{{ false }}">
            <div style="margin:16px 16px 0;" onClick="{{ goAuth }}" class="tap">
              <div style="background:linear-gradient(135deg,rgba(232,181,71,.18),rgba(232,181,71,.06));border:1px solid rgba(232,181,71,.35);border-radius:22px;padding:18px 20px;display:flex;align-items:center;gap:14px;">
                <div style="font-size:38px;flex:0 0 auto;">🥤</div>
                <div style="flex:1;min-width:0;">
                  <div style="font-weight:800;color:var(--gold-glow);font-size:15px;margin-bottom:4px;">Unlock Pour Pass Rewards</div>
                  <div style="font-size:13px;color:rgba(255,255,255,.65);line-height:1.4;">Sign in to earn points, spin the wheel &amp; compete for monthly prizes.</div>
                </div>
                <button style="background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:13px;padding:10px 16px;border-radius:99px;border:0;flex:0 0 auto;white-space:nowrap;">Sign In</button>
              </div>
            </div>
            </sc-if>

            <div style="height:118px;"></div>
          </div>
        </div>
        </sc-if>

        <!-- ===================== MENU ===================== -->
        <sc-if value="{{ isMenu }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .35s ease both;padding-bottom:120px;">
          <div style="padding:44px 20px 16px;background:{{ splashGrad }};color:#fff;position:relative;overflow:hidden;">
            <svg viewBox="0 0 240 520" style="position:absolute;left:-40px;bottom:-150px;width:160px;height:auto;"><g fill="rgba(0,0,0,.14)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <div style="position:absolute;top:8px;right:-8px;font-size:96px;opacity:.22;transform:rotate(-12deg);">🥤</div>
            <div style="position:absolute;top:14px;right:60px;font-size:54px;animation:bobY 7s ease-in-out infinite;--r:-8deg;filter:drop-shadow(0 6px 10px rgba(0,0,0,.18));pointer-events:none;z-index:1;">🍊</div>
            <div style="position:absolute;bottom:10px;left:-6px;font-size:46px;animation:bobYr 9s ease-in-out infinite;filter:drop-shadow(0 6px 10px rgba(0,0,0,.16));pointer-events:none;z-index:1;">🥕</div>
            <div style="position:absolute;top:50%;right:-10px;font-size:38px;animation:bobY 11s ease-in-out infinite;--r:10deg;filter:drop-shadow(0 4px 8px rgba(0,0,0,.15));pointer-events:none;z-index:1;">🌿</div>
            <div style="position:relative;z-index:2;margin-bottom:12px;"><img src="assets/logo-clean-512.png" style="height:32px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));" alt="Pour Decisions"></div>
            <div style="font-family:var(--f-num);letter-spacing:.22em;font-size:13px;color:rgba(255,255,255,.85);">THE MENU</div>
            <h2 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:38px;line-height:.94;margin:6px 0 16px;letter-spacing:-.03em;">Pick your pour</h2>
            <div class="noscroll" style="display:flex;gap:8px;overflow-x:auto;">
              <sc-for list="{{ categories }}" as="cat" hint-placeholder-count="5">
                <span onClick="{{ cat.go }}" class="tap" style="flex:0 0 auto;font-weight:800;font-size:13px;padding:9px 16px;border-radius:99px;background:{{ cat.bg }};color:{{ cat.fg }};">{{ cat.label }}</span>
              </sc-for>
            </div>
          </div>
          <div style="padding:18px 16px 0;" class="menu-columns">
            <!-- DRINKS SECTION -->
            <div>
              <sc-if value="{{ hasDrinkItems }}" hint-placeholder-val="{{ true }}">
              <div style="font-family:var(--f-num);letter-spacing:.14em;font-size:12px;color:var(--gold-glow);margin-bottom:12px;">🥤 DRINKS</div>
              <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:20px;">
                <sc-for list="{{ menuDrinks }}" as="it" hint-placeholder-count="4">
                  <div onClick="{{ it.open }}" class="tap" style="display:flex;gap:14px;align-items:center;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:22px;padding:12px;">
                    <div style="flex:0 0 78px;width:78px;height:78px;border-radius:18px;background:{{ it.grad }};display:grid;place-items:center;font-size:40px;box-shadow:0 8px 18px {{ it.shadow }};">{{ it.emoji }}</div>
                    <div style="flex:1;min-width:0;">
                      <div style="display:flex;align-items:center;gap:7px;"><span style="font-size:9px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--gold-glow);">{{ it.cat }}</span><span style="font-size:11px;color:rgba(255,255,255,.5);font-weight:600;">{{ it.calLabel }}</span></div>
                      <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:20px;color:#fff;line-height:1.05;margin-top:2px;">{{ it.name }}</div>
                      <div style="font-size:11.5px;color:rgba(255,255,255,.6);font-weight:500;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ it.ingredients }}</div>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:8px;">
                      <span style="font-family:var(--f-num);font-size:26px;color:var(--gold-glow);line-height:1;">{{ it.priceLabel }}</span>
                      <button onClick="{{ it.add }}" class="tap" style="width:34px;height:34px;border-radius:50%;background:var(--gold);border:0;color:var(--teal-deep);font-size:22px;font-weight:800;display:grid;place-items:center;line-height:1;box-shadow:0 6px 14px rgba(232,181,71,.4);">+</button>
                    </div>
                  </div>
                </sc-for>
              </div>
              </sc-if>
            </div>
            <!-- FOOD SECTION -->
            <div>
              <sc-if value="{{ hasFoodItems }}" hint-placeholder-val="{{ false }}">
              <div style="font-family:var(--f-num);letter-spacing:.14em;font-size:12px;color:var(--gold-glow);margin-bottom:12px;">🍽️ FOOD</div>
              <div style="display:flex;flex-direction:column;gap:14px;">
                <sc-for list="{{ menuFood }}" as="it" hint-placeholder-count="2">
                  <div onClick="{{ it.open }}" class="tap" style="display:flex;gap:14px;align-items:center;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:22px;padding:12px;">
                    <div style="flex:0 0 78px;width:78px;height:78px;border-radius:18px;background:{{ it.grad }};display:grid;place-items:center;font-size:40px;box-shadow:0 8px 18px {{ it.shadow }};">{{ it.emoji }}</div>
                    <div style="flex:1;min-width:0;">
                      <div style="display:flex;align-items:center;gap:7px;"><span style="font-size:9px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--gold-glow);">{{ it.cat }}</span><span style="font-size:11px;color:rgba(255,255,255,.5);font-weight:600;">{{ it.calLabel }}</span></div>
                      <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:20px;color:#fff;line-height:1.05;margin-top:2px;">{{ it.name }}</div>
                      <div style="font-size:11.5px;color:rgba(255,255,255,.6);font-weight:500;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ it.ingredients }}</div>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:8px;">
                      <span style="font-family:var(--f-num);font-size:26px;color:var(--gold-glow);line-height:1;">{{ it.priceLabel }}</span>
                      <button onClick="{{ it.add }}" class="tap" style="width:34px;height:34px;border-radius:50%;background:var(--gold);border:0;color:var(--teal-deep);font-size:22px;font-weight:800;display:grid;place-items:center;line-height:1;box-shadow:0 6px 14px rgba(232,181,71,.4);">+</button>
                    </div>
                  </div>
                </sc-for>
              </div>
              </sc-if>
            </div>
          </div>
        </div>
        </sc-if>

        <!-- ===================== ITEM DETAIL ===================== -->
        <sc-if value="{{ isDetail }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .35s ease both;padding-bottom:150px;">
          <div style="position:relative;min-height:340px;padding:44px 20px 30px;color:#fff;background:{{ item.grad }};overflow:hidden;">
            <svg viewBox="0 0 240 520" style="position:absolute;left:-46px;bottom:-90px;width:165px;height:auto;"><g fill="rgba(0,0,0,.13)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <div style="position:absolute;top:44px;right:-30px;font-size:230px;opacity:.28;line-height:1;transform:rotate(-10deg);">{{ item.emoji }}</div>
            <div style="display:flex;justify-content:space-between;align-items:center;position:relative;z-index:2;">
              <button onClick="{{ back }}" class="tap" style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.25);border:0;display:grid;place-items:center;backdrop-filter:blur(4px);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </button>
              <img src="assets/logo-clean-512.png" style="height:32px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));" alt="Pour Decisions">
              <button onClick="{{ goCart }}" class="tap" style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.25);border:0;display:grid;place-items:center;backdrop-filter:blur(4px);">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M3 4h2l2.5 12.5A2 2 0 0 0 9.5 18h8.5l2-9H6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </button>
            </div>
            <div style="position:relative;z-index:2;margin-top:60px;">
              <span style="font-family:var(--f-num);letter-spacing:.2em;font-size:13px;background:rgba(0,0,0,.18);padding:4px 12px;border-radius:99px;">{{ item.cat }} · {{ item.calLabel }}</span>
              <h2 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:44px;line-height:.9;letter-spacing:-.03em;margin:12px 0 0;text-shadow:0 3px 14px rgba(0,0,0,.2);">{{ item.name }}</h2>
            </div>
          </div>
          <div style="background:var(--navy);border-radius:30px 30px 0 0;margin-top:-24px;position:relative;z-index:3;padding:26px 20px 0;">
            <p style="color:rgba(255,255,255,.82);font-size:15px;line-height:1.6;font-weight:500;margin:0 0 20px;">{{ item.blurb }}</p>
            <div style="font-family:var(--f-num);letter-spacing:.16em;font-size:13px;color:var(--gold-glow);margin-bottom:10px;">WHAT'S INSIDE</div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px;">
              <sc-for list="{{ item.ingList }}" as="ing" hint-placeholder-count="4">
                <span style="background:rgba(255,255,255,.08);color:#fff;font-weight:600;font-size:13px;padding:9px 15px;border-radius:99px;border:1px solid rgba(255,255,255,.1);">{{ ing }}</span>
              </sc-for>
            </div>
            <div style="font-family:var(--f-num);letter-spacing:.16em;font-size:13px;color:var(--lime);margin-bottom:10px;">WHY IT'S GOOD FOR YOU</div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px;">
              <sc-for list="{{ item.benefits }}" as="b" hint-placeholder-count="3">
                <span style="display:inline-flex;align-items:center;gap:6px;background:rgba(163,230,53,.1);color:#D8F5A2;font-weight:700;font-size:13px;padding:9px 15px;border-radius:99px;border:1px solid rgba(163,230,53,.25);">✓ {{ b }}</span>
              </sc-for>
            </div>
            <div style="display:flex;gap:12px;margin-bottom:24px;">
              <sc-for list="{{ item.macros }}" as="m" hint-placeholder-count="3">
                <div style="flex:1;background:rgba(255,255,255,.05);border-radius:18px;padding:14px 10px;text-align:center;border:1px solid rgba(255,255,255,.07);">
                  <div style="font-family:var(--f-num);font-size:28px;color:#fff;line-height:1;">{{ m.value }}</div>
                  <div style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.5);margin-top:4px;">{{ m.label }}</div>
                </div>
              </sc-for>
            </div>
          </div>
          <div style="position:sticky;bottom:0;background:linear-gradient(180deg,rgba(28,31,46,0),var(--navy) 34%);padding:18px 20px 26px;display:flex;gap:14px;align-items:center;z-index:5;">
            <div style="display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.08);border-radius:99px;padding:8px 10px;">
              <button onClick="{{ decQty }}" class="tap" style="width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.12);border:0;color:#fff;font-size:22px;line-height:1;display:grid;place-items:center;">−</button>
              <span style="font-family:var(--f-num);font-size:24px;color:#fff;min-width:20px;text-align:center;">{{ qty }}</span>
              <button onClick="{{ incQty }}" class="tap" style="width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.12);border:0;color:#fff;font-size:22px;line-height:1;display:grid;place-items:center;">+</button>
            </div>
            <button onClick="{{ addDetail }}" class="tap" style="flex:1;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:15px;padding:16px;border-radius:99px;border:0;box-shadow:0 10px 24px rgba(232,181,71,.45);">Add · {{ detailTotal }}</button>
          </div>
        </div>
        </sc-if>

        <!-- ===================== CART ===================== -->
        <sc-if value="{{ isCart }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .35s ease both;min-height:100%;display:flex;flex-direction:column;">
          <div style="padding:44px 20px 18px;background:linear-gradient(160deg,#E8426A 0%,#C4284E 60%,#8B1A35 100%);display:flex;align-items:center;gap:12px;position:relative;overflow:hidden;">
            <svg viewBox="0 0 240 520" style="position:absolute;left:-52px;top:60px;width:160px;height:auto;transform:scaleX(-1);pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.3)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <svg viewBox="0 0 240 520" style="position:absolute;right:-58px;top:20px;width:220px;height:auto;pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.22)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <div style="position:absolute;top:14px;right:10px;font-size:52px;animation:bobY 8s ease-in-out infinite;--r:-10deg;filter:drop-shadow(0 6px 10px rgba(0,0,0,.2));pointer-events:none;z-index:1;">🥝</div>
            <div style="position:absolute;bottom:8px;left:10px;font-size:44px;animation:bobYr 10s ease-in-out infinite;filter:drop-shadow(0 6px 10px rgba(0,0,0,.18));pointer-events:none;z-index:1;">🍋</div>
            <button onClick="{{ back }}" class="tap" style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.25);border:0;display:grid;place-items:center;position:relative;z-index:2;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
            <h2 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:30px;color:#fff;margin:0;letter-spacing:-.02em;position:relative;z-index:2;">Your order</h2>
            <img src="assets/logo-clean-512.png" style="margin-left:auto;height:28px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));position:relative;z-index:2;" alt="Pour Decisions">
          </div>
          <sc-if value="{{ hasCart }}" hint-placeholder-val="{{ true }}">
          <div style="flex:1;padding:6px 16px 0;display:flex;flex-direction:column;gap:12px;">
            <sc-for list="{{ cart }}" as="ci" hint-placeholder-count="2">
              <div style="display:flex;gap:12px;align-items:center;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:11px;">
                <div style="flex:0 0 62px;width:62px;height:62px;border-radius:16px;background:{{ ci.grad }};display:grid;place-items:center;font-size:32px;">{{ ci.emoji }}</div>
                <div style="flex:1;min-width:0;">
                  <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:18px;color:#fff;line-height:1;">{{ ci.name }}</div>
                  <div style="font-family:var(--f-num);font-size:22px;color:var(--gold-glow);margin-top:3px;">{{ ci.lineLabel }}</div>
                </div>
                <div style="display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.08);border-radius:99px;padding:6px 8px;">
                  <button onClick="{{ ci.dec }}" class="tap" style="width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,.12);border:0;color:#fff;font-size:18px;line-height:1;display:grid;place-items:center;">−</button>
                  <span style="font-family:var(--f-num);font-size:19px;color:#fff;min-width:16px;text-align:center;">{{ ci.qty }}</span>
                  <button onClick="{{ ci.inc }}" class="tap" style="width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,.12);border:0;color:#fff;font-size:18px;line-height:1;display:grid;place-items:center;">+</button>
                </div>
              </div>
            </sc-for>
            <div onClick="{{ goMenu }}" class="tap" style="text-align:center;color:var(--gold-glow);font-weight:700;font-size:13px;padding:8px;">+ Add more</div>
          </div>
          <div style="padding:16px 20px 0;">
            <div style="display:flex;justify-content:space-between;color:rgba(255,255,255,.6);font-size:13px;font-weight:600;margin-bottom:6px;"><span>Subtotal</span><span>{{ subtotalLabel }}</span></div>
            <div style="display:flex;justify-content:space-between;color:rgba(255,255,255,.6);font-size:13px;font-weight:600;margin-bottom:12px;"><span>Tax</span><span>{{ taxLabel }}</span></div>
            <div style="display:flex;justify-content:space-between;align-items:baseline;padding-top:12px;border-top:1px solid rgba(255,255,255,.1);">
              <span style="color:#fff;font-weight:800;font-size:15px;">Total</span>
              <span style="font-family:var(--f-num);font-size:34px;color:var(--gold-glow);">{{ totalLabel }}</span>
            </div>
          </div>
          <div style="padding:16px 20px 26px;">
            <button onClick="{{ goCheckout }}" class="tap" style="width:100%;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:16px;padding:17px;border-radius:99px;border:0;box-shadow:0 10px 24px rgba(232,181,71,.45);">Checkout · {{ totalLabel }}</button>
          </div>
          </sc-if>
          <sc-if value="{{ cartEmpty }}" hint-placeholder-val="{{ false }}">
          <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px;color:rgba(255,255,255,.7);">
            <div style="font-size:76px;filter:grayscale(.2);">🥤</div>
            <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:24px;color:#fff;margin-top:12px;">Nothing poured yet</div>
            <p style="font-size:14px;margin:8px 0 20px;">Your cup's empty — let's fix that.</p>
            <button onClick="{{ goMenu }}" class="tap" style="background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:15px;padding:14px 28px;border-radius:99px;border:0;">Browse the menu</button>
          </div>
          </sc-if>
          <div style="height:96px;"></div>
        </div>
        </sc-if>

        <!-- ===================== CHECKOUT ===================== -->
        <sc-if value="{{ isCheckout }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .35s ease both;padding-bottom:150px;">
          <div style="padding:44px 20px 18px;background:linear-gradient(160deg,#E8426A 0%,#C4284E 60%,#8B1A35 100%);display:flex;align-items:center;gap:12px;position:relative;overflow:hidden;">
            <svg viewBox="0 0 240 520" style="position:absolute;left:-52px;top:60px;width:160px;height:auto;transform:scaleX(-1);pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.3)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <svg viewBox="0 0 240 520" style="position:absolute;right:-58px;top:20px;width:220px;height:auto;pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.22)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <div style="position:absolute;top:12px;right:12px;font-size:50px;animation:bobYr 8s ease-in-out infinite;filter:drop-shadow(0 6px 10px rgba(0,0,0,.2));pointer-events:none;z-index:1;">🍓</div>
            <div style="position:absolute;bottom:8px;left:8px;font-size:42px;animation:bobY 11s ease-in-out infinite;--r:8deg;filter:drop-shadow(0 6px 10px rgba(0,0,0,.18));pointer-events:none;z-index:1;">🥦</div>
            <button onClick="{{ goCart }}" class="tap" style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.25);border:0;display:grid;place-items:center;position:relative;z-index:2;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
            <h2 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:30px;color:#fff;margin:0;letter-spacing:-.02em;position:relative;z-index:2;">Checkout</h2>
            <img src="assets/logo-clean-512.png" style="margin-left:auto;height:28px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));position:relative;z-index:2;" alt="Pour Decisions">
          </div>
          <div style="padding:6px 20px 0;display:flex;flex-direction:column;gap:16px;">
            <div>
              <div style="font-family:var(--f-num);letter-spacing:.16em;font-size:13px;color:var(--gold-glow);margin-bottom:10px;">PICKUP</div>
              <div style="display:flex;gap:10px;">
                <sc-for list="{{ pickupOptions }}" as="p" hint-placeholder-count="2">
                  <div onClick="{{ p.select }}" class="tap" style="flex:1;border-radius:18px;padding:14px;background:{{ p.bg }};border:1.5px solid {{ p.border }};color:#fff;">
                    <div style="font-weight:800;font-size:14px;">{{ p.title }}</div>
                    <div style="font-size:12px;color:rgba(255,255,255,.6);margin-top:2px;">{{ p.sub }}</div>
                  </div>
                </sc-for>
              </div>
            </div>
            <div>
              <div style="font-family:var(--f-num);letter-spacing:.16em;font-size:13px;color:var(--gold-glow);margin-bottom:10px;">STORE</div>
              <div style="display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:14px;">
                <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(150deg,#E8426A,#C4284E);display:grid;place-items:center;font-size:22px;">📍</div>
                <div><div style="font-weight:800;color:#fff;font-size:14px;">Pour Decisions · Albany</div><div style="font-size:12px;color:rgba(255,255,255,.6);">275 Lark St · ready in ~12 min</div></div>
              </div>
            </div>
            <div>
              <div style="font-family:var(--f-num);letter-spacing:.16em;font-size:13px;color:var(--gold-glow);margin-bottom:10px;">PAY WITH</div>
              <div style="display:flex;flex-direction:column;gap:10px;">
                <sc-for list="{{ payOptions }}" as="pm" hint-placeholder-count="3">
                  <div onClick="{{ pm.select }}" class="tap" style="display:flex;align-items:center;gap:12px;background:{{ pm.bg }};border:1.5px solid {{ pm.border }};border-radius:16px;padding:14px;color:#fff;">
                    <span style="font-size:22px;">{{ pm.icon }}</span>
                    <span style="font-weight:700;font-size:14px;flex:1;">{{ pm.label }}</span>
                    <span style="width:20px;height:20px;border-radius:50%;border:2px solid {{ pm.dot }};display:grid;place-items:center;"><span style="width:10px;height:10px;border-radius:50%;background:{{ pm.dotFill }};"></span></span>
                  </div>
                </sc-for>
              </div>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:baseline;padding-top:8px;">
              <span style="color:#fff;font-weight:800;font-size:15px;">Total</span>
              <span style="font-family:var(--f-num);font-size:34px;color:var(--gold-glow);">{{ totalLabel }}</span>
            </div>
          </div>
          <div style="position:sticky;bottom:0;background:linear-gradient(180deg,rgba(28,31,46,0),var(--navy) 34%);padding:18px 20px 26px;z-index:5;">
            <button onClick="{{ placeOrder }}" class="tap" style="width:100%;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:16px;padding:17px;border-radius:99px;border:0;box-shadow:0 10px 24px rgba(232,181,71,.45);">Place order · {{ totalLabel }}</button>
          </div>
        </div>
        </sc-if>

        <!-- ===================== CONFIRMATION ===================== -->
        <sc-if value="{{ isConfirm }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .4s ease both;min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 30px 120px;background:{{ splashGrad }};color:#fff;position:relative;overflow:hidden;">
          <svg viewBox="0 0 240 520" style="position:absolute;right:-46px;bottom:-40px;width:210px;height:auto;"><g fill="rgba(0,0,0,.15)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
          <svg viewBox="0 0 240 520" style="position:absolute;left:-44px;bottom:-24px;width:135px;height:auto;transform:scaleX(-1);"><g fill="rgba(0,0,0,.11)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
          <div style="position:absolute;top:60px;left:-10px;font-size:60px;animation:bobYr 6s ease-in-out infinite;">🍓</div>
          <div style="position:absolute;top:120px;right:-6px;font-size:70px;animation:bobY 7s ease-in-out infinite;--r:-10deg;">🍊</div>
          <div style="position:absolute;bottom:180px;left:24px;font-size:48px;animation:bobY 8s ease-in-out infinite;--r:10deg;">🥝</div>
          <div style="position:absolute;top:200px;left:16px;font-size:52px;animation:bobYr 10s ease-in-out infinite;filter:drop-shadow(0 6px 10px rgba(0,0,0,.2));">🍋</div>
          <div style="position:absolute;bottom:280px;right:14px;font-size:46px;animation:bobY 12s ease-in-out infinite;--r:8deg;filter:drop-shadow(0 6px 10px rgba(0,0,0,.18));">🥦</div>
          <div style="position:absolute;bottom:100px;right:-8px;font-size:42px;animation:bobYr 9s ease-in-out infinite;filter:drop-shadow(0 4px 8px rgba(0,0,0,.16));">🥕</div>
          <img src="assets/logo-clean-512.png" style="position:relative;z-index:2;height:34px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));margin-bottom:24px;" alt="Pour Decisions">
          <div style="width:110px;height:110px;border-radius:50%;background:rgba(255,255,255,.2);display:grid;place-items:center;animation:popIn .5s ease both;backdrop-filter:blur(4px);">
            <div style="width:80px;height:80px;border-radius:50%;background:var(--gold);display:grid;place-items:center;box-shadow:0 10px 26px rgba(0,0,0,.25);">
              <svg width="42" height="42" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4 10-11" stroke="#12303C" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </div>
          </div>
          <h2 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:42px;line-height:.95;letter-spacing:-.03em;margin:22px 0 0;text-shadow:0 3px 14px rgba(0,0,0,.2);">Pour<br>incoming!</h2>
          <p style="font-size:15px;font-weight:500;margin:14px 0 0;max-width:24ch;color:rgba(255,255,255,.92);">Order <b>#{{ orderNo }}</b> is being pressed. Ready in ~12 min at Lark St.</p>
          <div style="background:rgba(0,0,0,.16);border-radius:20px;padding:16px 22px;margin-top:22px;backdrop-filter:blur(4px);">
            <div style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.7);font-weight:700;">+{{ pointsEarned }} Pour Points earned</div>
          </div>
          <button onClick="{{ goWheel }}" class="tap" style="margin-top:26px;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:15px;padding:15px 30px;border-radius:99px;border:0;box-shadow:0 10px 24px rgba(0,0,0,.2);">🎡 Spin your free daily prize</button>
          <div onClick="{{ goHome }}" class="tap" style="margin-top:14px;color:#fff;font-weight:700;font-size:13px;text-decoration:underline;text-underline-offset:3px;">Back to home</div>
        </div>
        </sc-if>

        <!-- ===================== POUR PASS ===================== -->
        <sc-if value="{{ isPass }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .35s ease both;padding-bottom:120px;">
          <div style="padding:44px 20px 24px;background:linear-gradient(155deg,#E8426A,#C4284E 55%,#8B1A35);color:#fff;position:relative;overflow:hidden;">
            <svg viewBox="0 0 240 520" style="position:absolute;left:-40px;bottom:-130px;width:155px;height:auto;"><g fill="rgba(180,20,55,.25)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <div style="position:absolute;bottom:-40px;right:-14px;font-size:150px;opacity:.24;">🥤</div>
            <div style="position:absolute;top:18px;right:8px;font-size:54px;animation:bobY 8s ease-in-out infinite;--r:-10deg;filter:drop-shadow(0 6px 10px rgba(0,0,0,.2));pointer-events:none;z-index:1;">🍋</div>
            <div style="position:absolute;top:60px;left:-6px;font-size:46px;animation:bobYr 10s ease-in-out infinite;filter:drop-shadow(0 6px 10px rgba(0,0,0,.18));pointer-events:none;z-index:1;">🥝</div>
            <svg viewBox="0 0 240 520" style="position:absolute;right:-58px;top:20px;width:220px;height:auto;pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.22)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <div style="position:relative;z-index:2;margin-bottom:14px;"><img src="assets/logo-clean-512.png" style="height:32px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));" alt="Pour Decisions"></div>
            <div style="font-family:var(--f-num);letter-spacing:.22em;font-size:14px;">POUR PASS</div>
            <h2 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:40px;line-height:.92;letter-spacing:-.03em;margin:6px 0 20px;">Sip. Earn.<br>Repeat.</h2>
            <div style="background:rgba(28,31,46,.92);border-radius:24px;padding:22px;color:#fff;box-shadow:0 16px 34px rgba(0,0,0,.2);position:relative;overflow:hidden;">
              <div style="display:flex;justify-content:space-between;align-items:baseline;">
                <div><div style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.55);font-weight:700;">Pour Points</div><div style="font-family:var(--f-num);font-size:52px;color:var(--gold-glow);line-height:.9;margin-top:2px;">{{ points }}</div></div>
                <div style="text-align:right;"><div style="font-size:11px;color:rgba(255,255,255,.55);font-weight:700;">Gold Member</div><div style="font-size:13px;color:#fff;font-weight:700;margin-top:2px;">🥇 {{ memberSince }}</div></div>
              </div>
              <div style="margin-top:18px;">
                <div style="display:flex;justify-content:space-between;font-size:12px;font-weight:700;margin-bottom:8px;"><span style="color:#fff;">{{ passFilled }} of 9 pours</span><span style="color:var(--gold-glow);">Free juice at 9</span></div>
                <div style="display:flex;gap:5px;">
                  <sc-for list="{{ stamps }}" as="s" hint-placeholder-count="9">
                    <span style="flex:1;height:10px;border-radius:99px;background:{{ s.bg }};"></span>
                  </sc-for>
                </div>
              </div>
            </div>
          </div>
          <div style="padding:20px 16px 0;">
            <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:24px;color:#fff;margin-bottom:14px;letter-spacing:-.02em;">Rewards to redeem</div>
            <div style="display:flex;flex-direction:column;gap:12px;">
              <sc-for list="{{ rewards }}" as="r" hint-placeholder-count="3">
                <div style="display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:14px;">
                  <div style="flex:0 0 54px;width:54px;height:54px;border-radius:16px;background:{{ r.grad }};display:grid;place-items:center;font-size:28px;">{{ r.emoji }}</div>
                  <div style="flex:1;"><div style="font-weight:800;color:#fff;font-size:15px;">{{ r.title }}</div><div style="font-size:12px;color:rgba(255,255,255,.6);">{{ r.cost }} points</div></div>
                  <button class="tap" style="background:{{ r.btnBg }};color:{{ r.btnFg }};font-weight:800;font-size:12px;padding:9px 16px;border-radius:99px;border:0;">{{ r.btnLabel }}</button>
                </div>
              </sc-for>
            </div>
          </div>
          <div style="height:110px;"></div>
        </div>
        </sc-if>

        <!-- ===================== NOTIFICATIONS ===================== -->
        <sc-if value="{{ isNotif }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .35s ease both;padding-bottom:120px;">
          <div style="padding:44px 20px 18px;background:linear-gradient(160deg,#E8426A 0%,#C4284E 60%,#8B1A35 100%);display:flex;align-items:center;gap:12px;position:relative;overflow:hidden;">
            <svg viewBox="0 0 240 520" style="position:absolute;left:-52px;top:60px;width:160px;height:auto;transform:scaleX(-1);pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.3)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <svg viewBox="0 0 240 520" style="position:absolute;right:-58px;top:20px;width:220px;height:auto;pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.22)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <div style="position:absolute;top:14px;right:12px;font-size:50px;animation:bobY 9s ease-in-out infinite;--r:-10deg;filter:drop-shadow(0 6px 10px rgba(0,0,0,.2));pointer-events:none;z-index:1;">🥕</div>
            <div style="position:absolute;bottom:8px;left:10px;font-size:40px;animation:bobYr 11s ease-in-out infinite;filter:drop-shadow(0 4px 8px rgba(0,0,0,.16));pointer-events:none;z-index:1;">🥬</div>
            <button onClick="{{ goHome }}" class="tap" style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.25);border:0;display:grid;place-items:center;position:relative;z-index:2;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
            <h2 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:30px;color:#fff;margin:0;letter-spacing:-.02em;position:relative;z-index:2;">Fresh drops</h2>
            <img src="assets/logo-clean-512.png" style="margin-left:auto;height:28px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));position:relative;z-index:2;" alt="Pour Decisions">
          </div>
          <div style="padding:6px 16px 0;display:flex;flex-direction:column;gap:12px;">
            <sc-for list="{{ notifications }}" as="n" hint-placeholder-count="4">
              <div style="display:flex;gap:13px;background:{{ n.bg }};border:1px solid {{ n.border }};border-radius:20px;padding:15px;">
                <div style="flex:0 0 46px;width:46px;height:46px;border-radius:14px;background:{{ n.grad }};display:grid;place-items:center;font-size:24px;">{{ n.emoji }}</div>
                <div style="flex:1;">
                  <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px;"><span style="font-weight:800;color:#fff;font-size:14px;">{{ n.title }}</span><span style="font-size:11px;color:rgba(255,255,255,.45);font-weight:600;white-space:nowrap;">{{ n.time }}</span></div>
                  <p style="font-size:13px;color:rgba(255,255,255,.65);margin:3px 0 0;line-height:1.45;">{{ n.body }}</p>
                </div>
              </div>
            </sc-for>
          </div>
        </div>
        </sc-if>

        <!-- ===================== ACCOUNT ===================== -->
        <sc-if value="{{ isAccount }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .35s ease both;padding-bottom:120px;">
          <div style="padding:48px 20px 26px;background:{{ splashGrad }};color:#fff;position:relative;overflow:hidden;">
            <svg viewBox="0 0 240 520" style="position:absolute;right:-34px;bottom:-140px;width:150px;height:auto;transform:scaleX(-1);"><g fill="rgba(0,0,0,.14)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <div style="position:absolute;top:-10px;right:-14px;font-size:130px;opacity:.2;">🍹</div>
            <div style="position:absolute;top:16px;left:-8px;font-size:52px;animation:bobY 9s ease-in-out infinite;--r:10deg;filter:drop-shadow(0 6px 10px rgba(0,0,0,.18));pointer-events:none;z-index:1;">🥦</div>
            <div style="position:absolute;bottom:10px;right:60px;font-size:44px;animation:bobYr 8s ease-in-out infinite;filter:drop-shadow(0 6px 10px rgba(0,0,0,.16));pointer-events:none;z-index:1;">🍋</div>
            <div style="position:relative;z-index:2;margin-bottom:18px;"><img src="assets/logo-clean-512.png" style="height:32px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));" alt="Pour Decisions"></div>
            <div style="display:flex;align-items:center;gap:16px;position:relative;z-index:2;">
              <div style="width:74px;height:74px;border-radius:50%;background:var(--gold);display:grid;place-items:center;font-family:var(--f-display);font-style:italic;font-weight:900;font-size:30px;color:var(--teal-deep);box-shadow:0 10px 24px rgba(0,0,0,.2);">{{ userInitial }}</div>
              <div><div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:26px;line-height:1;">{{ userName }}</div><div style="font-size:12px;color:rgba(255,255,255,.8);font-weight:600;margin-top:5px;">{{ userEmail }}</div><div style="font-size:12px;color:var(--gold-glow);font-weight:800;margin-top:3px;">🥇 Gold · {{ points }} points</div></div>
            </div>
          </div>
          <div style="padding:18px 16px 0;">
            <!-- Tab bar -->
            <div style="display:flex;gap:8px;margin-bottom:16px;">
              <button onClick="{{ setTabOverview }}" class="tap" style="flex:1;background:{{ tabOverviewBg }};color:{{ tabOverviewFg }};font-weight:800;font-size:13px;padding:10px 6px;border-radius:99px;border:0;">Overview</button>
              <button onClick="{{ setTabTransactions }}" class="tap" style="flex:1;background:{{ tabTxBg }};color:{{ tabTxFg }};font-weight:800;font-size:13px;padding:10px 6px;border-radius:99px;border:0;">Transactions</button>
              <button onClick="{{ setTabPrizes }}" class="tap" style="flex:1;background:{{ tabPrBg }};color:{{ tabPrFg }};font-weight:800;font-size:13px;padding:10px 6px;border-radius:99px;border:0;">Prizes</button>
            </div>

            <!-- OVERVIEW TAB -->
            <sc-if value="{{ isAccountOverview }}" hint-placeholder-val="{{ true }}">
            <div>
              <div style="display:flex;gap:12px;margin-bottom:18px;">
                <div style="flex:1;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:16px;text-align:center;"><div style="font-family:var(--f-num);font-size:32px;color:var(--gold-glow);line-height:1;">{{ ordersCount }}</div><div style="font-size:11px;color:rgba(255,255,255,.55);font-weight:700;letter-spacing:.05em;text-transform:uppercase;margin-top:4px;">Orders</div></div>
                <div style="flex:1;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:16px;text-align:center;"><div style="font-family:var(--f-num);font-size:32px;color:var(--gold-glow);line-height:1;">{{ passFilled }}</div><div style="font-size:11px;color:rgba(255,255,255,.55);font-weight:700;letter-spacing:.05em;text-transform:uppercase;margin-top:4px;">Pours</div></div>
                <div style="flex:1;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:16px;text-align:center;"><div style="font-family:var(--f-num);font-size:32px;color:var(--gold-glow);line-height:1;">{{ points }}</div><div style="font-size:11px;color:rgba(255,255,255,.55);font-weight:700;letter-spacing:.05em;text-transform:uppercase;margin-top:4px;">Points</div></div>
              </div>
              <!-- Mini Pour Pass progress -->
              <div onClick="{{ goPass }}" class="tap" style="background:rgba(232,66,106,.1);border:1px solid rgba(232,66,106,.2);border-radius:18px;padding:14px 16px;margin-bottom:14px;">
                <div style="display:flex;justify-content:space-between;font-size:12px;font-weight:700;margin-bottom:8px;"><span style="color:#fff;">Pour Pass: {{ passFilled }}/9 pours</span><span style="color:var(--gold-glow);">Free at 9 →</span></div>
                <div style="display:flex;gap:4px;">
                  <span style="flex:{{ passFilled }};height:7px;border-radius:99px;background:var(--gold);"></span>
                  <span style="flex:{{ passEmpty }};height:7px;border-radius:99px;background:rgba(255,255,255,.15);"></span>
                </div>
              </div>
              <div style="display:flex;flex-direction:column;gap:2px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:20px;overflow:hidden;">
                <sc-for list="{{ accountRows }}" as="a" hint-placeholder-count="5">
                  <div onClick="{{ a.go }}" class="tap" style="display:flex;align-items:center;gap:13px;padding:16px;border-bottom:1px solid rgba(255,255,255,.05);">
                    <span style="font-size:20px;width:26px;text-align:center;">{{ a.icon }}</span>
                    <span style="flex:1;font-weight:700;color:#fff;font-size:14px;">{{ a.label }}</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="rgba(255,255,255,.4)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  </div>
                </sc-for>
              </div>
            </div>
            </sc-if>

            <!-- TRANSACTIONS TAB -->
            <sc-if value="{{ isAccountTransactions }}" hint-placeholder-val="{{ false }}">
            <div>
              <sc-if value="{{ hasOrders }}" hint-placeholder-val="{{ true }}">
              <div style="display:flex;flex-direction:column;gap:12px;">
                <sc-for list="{{ orderHistory }}" as="o" hint-placeholder-count="3">
                  <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:14px 16px;">
                    <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px;">
                      <span style="font-family:var(--f-num);font-size:18px;color:var(--gold-glow);">{{ o.idLabel }}</span>
                      <span style="font-size:11px;color:rgba(255,255,255,.5);font-weight:600;">{{ o.dateLabel }}</span>
                    </div>
                    <div style="font-size:13px;color:rgba(255,255,255,.7);font-weight:500;margin-bottom:6px;">{{ o.itemSummary }}</div>
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                      <span style="font-family:var(--f-num);font-size:22px;color:#fff;">{{ o.totalLabel }}</span>
                      <span style="font-size:11px;font-weight:700;color:#A3E635;background:rgba(163,230,53,.12);padding:4px 10px;border-radius:99px;">{{ o.pointsLabel }}</span>
                    </div>
                  </div>
                </sc-for>
              </div>
              </sc-if>
              <sc-if value="{{ noOrders }}" hint-placeholder-val="{{ false }}">
              <div style="text-align:center;padding:40px 20px;color:rgba(255,255,255,.6);">
                <div style="font-size:54px;margin-bottom:12px;">🧾</div>
                <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:22px;color:#fff;margin-bottom:8px;">No orders yet</div>
                <p style="font-size:13px;margin:0 0 16px;">Place your first order to see history here.</p>
                <button onClick="{{ goMenu }}" class="tap" style="background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:14px;padding:12px 24px;border-radius:99px;border:0;">Browse menu</button>
              </div>
              </sc-if>
            </div>
            </sc-if>

            <!-- PRIZES TAB -->
            <sc-if value="{{ isAccountPrizes }}" hint-placeholder-val="{{ false }}">
            <div>
              <sc-if value="{{ hasPrizes }}" hint-placeholder-val="{{ false }}">
              <div style="display:flex;flex-direction:column;gap:12px;">
                <sc-for list="{{ userPrizes }}" as="p" hint-placeholder-count="2">
                  <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:14px 16px;display:flex;align-items:center;gap:13px;">
                    <div style="width:52px;height:52px;border-radius:16px;background:rgba(255,255,255,.08);display:grid;place-items:center;font-size:30px;flex:0 0 52px;">{{ p.emoji }}</div>
                    <div style="flex:1;min-width:0;">
                      <div style="font-weight:800;color:#fff;font-size:15px;">{{ p.name }}</div>
                      <div style="font-size:11px;color:rgba(255,255,255,.5);margin-top:2px;">Won {{ p.wonDateLabel }}</div>
                      <span style="font-size:10px;font-weight:700;padding:3px 8px;border-radius:99px;background:{{ p.statusBg }};color:{{ p.statusFg }};display:inline-block;margin-top:4px;">{{ p.statusLabel }}</span>
                    </div>
                  </div>
                </sc-for>
              </div>
              </sc-if>
              <sc-if value="{{ noPrizes }}" hint-placeholder-val="{{ true }}">
              <div style="text-align:center;padding:40px 20px;color:rgba(255,255,255,.6);">
                <div style="font-size:54px;margin-bottom:12px;">🏆</div>
                <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:22px;color:#fff;margin-bottom:8px;">No prizes yet</div>
                <p style="font-size:13px;margin:0 0 16px;">Spin the wheel to win free pours!</p>
                <button onClick="{{ goWheel }}" class="tap" style="background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:14px;padding:12px 24px;border-radius:99px;border:0;">Spin now 🎡</button>
              </div>
              </sc-if>
            </div>
            </sc-if>
          </div>
        </div>
        </sc-if>

        <!-- ===================== PRIZE WHEEL ===================== -->
        <sc-if value="{{ isWheel }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .35s ease both;position:relative;min-height:720px;background:{{ splashGrad }};overflow:hidden;padding-bottom:120px;">
          <svg viewBox="0 0 240 520" style="position:absolute;left:-54px;bottom:-30px;width:200px;height:auto;"><g fill="rgba(0,0,0,.13)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
          <svg viewBox="0 0 240 520" style="position:absolute;right:-48px;bottom:120px;width:145px;height:auto;transform:scaleX(-1);"><g fill="rgba(0,0,0,.1)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
          <div style="position:absolute;top:70px;left:-14px;font-size:52px;opacity:.5;animation:bobYr 7s ease-in-out infinite;">🍓</div>
          <div style="position:absolute;top:150px;right:-8px;font-size:60px;opacity:.5;animation:bobY 8s ease-in-out infinite;--r:-10deg;">🍊</div>
          <div style="position:absolute;top:42px;right:50px;font-size:44px;opacity:.55;animation:bobY 11s ease-in-out infinite;--r:8deg;filter:drop-shadow(0 6px 10px rgba(0,0,0,.18));">🍋</div>
          <div style="position:absolute;top:230px;left:20px;font-size:38px;opacity:.5;animation:bobYr 13s ease-in-out infinite;filter:drop-shadow(0 4px 8px rgba(0,0,0,.15));">🥦</div>
          <div style="position:relative;z-index:3;padding:44px 20px 0;display:flex;align-items:center;gap:10px;">
            <button onClick="{{ back }}" class="tap" style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.25);border:0;display:grid;place-items:center;backdrop-filter:blur(4px);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
            <img src="assets/logo-clean-512.png" style="height:32px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));" alt="Pour Decisions">
          </div>
          <div style="position:relative;z-index:3;text-align:center;color:#fff;padding:14px 24px 4px;">
            <span style="font-family:var(--f-num);letter-spacing:.22em;font-size:14px;background:rgba(0,0,0,.16);padding:4px 14px;border-radius:99px;">FREE DAILY SPIN</span>
            <h2 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:40px;line-height:.92;letter-spacing:-.03em;margin:14px 0 6px;text-shadow:0 3px 14px rgba(0,0,0,.2);">Spin to win<br>a free pour</h2>
            <p style="font-size:13.5px;font-weight:500;color:rgba(255,255,255,.9);margin:0;">Land a slice, claim it free — on the house. 🍹</p>
          </div>

          <!-- WHEEL -->
          <div style="position:relative;z-index:3;width:300px;height:300px;margin:26px auto 0;">
            <!-- pointer -->
            <div style="position:absolute;top:-6px;left:50%;transform:translateX(-50%);z-index:6;width:0;height:0;border-left:16px solid transparent;border-right:16px solid transparent;border-top:26px solid var(--cream);filter:drop-shadow(0 4px 6px rgba(0,0,0,.3));"></div>
            <!-- rim -->
            <div style="position:absolute;inset:0;border-radius:50%;background:var(--cream);box-shadow:0 20px 50px rgba(0,0,0,.35),inset 0 0 0 6px rgba(18,48,60,.15);padding:12px;">
              <!-- rotating wheel -->
              <div style="position:relative;width:100%;height:100%;border-radius:50%;transition:transform 4.2s cubic-bezier(.16,.84,.3,1);transform:{{ wheelTransform }};background:conic-gradient(from -18deg,#84CC16 0deg 36deg,#FF3D80 36deg 72deg,#555 72deg 108deg,#FF8A3D 108deg 144deg,#FFC64D 144deg 180deg,#7C3AED 180deg 216deg,#FF7A8A 216deg 252deg,#555 252deg 288deg,#6D28D9 288deg 324deg,#E8B547 324deg 360deg);box-shadow:inset 0 0 0 3px rgba(255,255,255,.5);">
                <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(0deg) translateY(-96px);font-size:28px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.25));">🥬</div>
                <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(36deg) translateY(-96px);font-size:28px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.25));">🍓</div>
                <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(72deg) translateY(-96px);font-size:24px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.25));">😔</div>
                <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(108deg) translateY(-96px);font-size:28px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.25));">🍊</div>
                <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(144deg) translateY(-96px);font-size:28px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.25));">🥭</div>
                <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(180deg) translateY(-96px);font-size:28px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.25));">🫐</div>
                <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(216deg) translateY(-96px);font-size:28px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.25));">🍉</div>
                <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(252deg) translateY(-96px);font-size:24px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.25));">😔</div>
                <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(288deg) translateY(-96px);font-size:28px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.25));">🍇</div>
                <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(324deg) translateY(-96px);font-size:28px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.25));">🫚</div>
              </div>
            </div>
            <!-- center hub -->
            <button onClick="{{ spin }}" class="tap" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:6;width:86px;height:86px;border-radius:50%;background:var(--navy);border:5px solid var(--cream);color:var(--gold-glow);font-family:var(--f-num);letter-spacing:.1em;font-size:24px;display:grid;place-items:center;box-shadow:0 10px 24px rgba(0,0,0,.35);cursor:pointer;">{{ spinLabel }}</button>
          </div>

          <div style="position:relative;z-index:3;text-align:center;margin-top:22px;">
            <button onClick="{{ spin }}" class="tap" style="background:var(--navy);color:#fff;font-weight:800;font-size:15px;padding:15px 40px;border-radius:99px;border:0;box-shadow:0 12px 28px rgba(0,0,0,.28);">🎡 Spin the wheel</button>
            <p style="color:rgba(255,255,255,.82);font-size:12px;font-weight:600;margin:14px 0 0;">1 free spin every day · come back tomorrow for more</p>
          </div>

          <!-- WIN OVERLAY: Signed-in + won a prize -->
          <sc-if value="{{ showWinClaim }}" hint-placeholder-val="{{ false }}">
          <div style="position:absolute;inset:0;z-index:20;background:rgba(9,22,28,.72);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:30px;animation:floatIn .3s ease both;">
            <div style="width:100%;max-width:320px;background:var(--navy);border-radius:30px;padding:30px 26px;text-align:center;border:1px solid rgba(255,255,255,.1);box-shadow:0 30px 70px rgba(0,0,0,.5);animation:popIn .4s ease both;position:relative;overflow:hidden;">
              <div style="position:absolute;top:-30px;left:-10px;font-size:50px;opacity:.5;">🎉</div>
              <div style="position:absolute;top:-24px;right:-6px;font-size:44px;opacity:.5;">✨</div>
              <div style="width:120px;height:120px;border-radius:50%;margin:0 auto;background:{{ wonItem.grad }};display:grid;place-items:center;font-size:60px;box-shadow:0 14px 30px rgba(0,0,0,.3);">{{ wonItem.emoji }}</div>
              <div style="font-family:var(--f-num);letter-spacing:.2em;font-size:14px;color:var(--gold-glow);margin-top:18px;">YOU WON</div>
              <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:30px;color:#fff;line-height:1;margin-top:4px;">{{ wonItem.name }}</div>
              <div style="font-size:13px;color:rgba(255,255,255,.6);font-weight:600;margin-top:6px;">A free {{ wonItem.cat }}, on us 🍹</div>
              <button onClick="{{ claimFree }}" class="tap" style="width:100%;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:15px;padding:16px;border-radius:99px;border:0;margin-top:22px;box-shadow:0 10px 24px rgba(232,181,71,.4);">Claim it free →</button>
              <div onClick="{{ dismissWin }}" class="tap" style="color:rgba(255,255,255,.6);font-weight:700;font-size:13px;margin-top:14px;">Maybe later</div>
            </div>
          </div>
          </sc-if>

          <!-- WIN OVERLAY: Not signed in + won — prompt to sign in -->
          <sc-if value="{{ showWinSignInPrompt }}" hint-placeholder-val="{{ false }}">
          <div style="position:absolute;inset:0;z-index:20;background:rgba(9,22,28,.72);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:30px;animation:floatIn .3s ease both;">
            <div style="width:100%;max-width:320px;background:var(--navy);border-radius:30px;padding:30px 26px;text-align:center;border:1px solid rgba(255,255,255,.1);box-shadow:0 30px 70px rgba(0,0,0,.5);animation:popIn .4s ease both;position:relative;overflow:hidden;">
              <div style="position:absolute;top:-30px;left:-10px;font-size:50px;opacity:.5;">🎉</div>
              <div style="position:absolute;top:-24px;right:-6px;font-size:44px;opacity:.5;">✨</div>
              <div style="width:120px;height:120px;border-radius:50%;margin:0 auto;background:{{ wonItem.grad }};display:grid;place-items:center;font-size:60px;box-shadow:0 14px 30px rgba(0,0,0,.3);">{{ wonItem.emoji }}</div>
              <div style="font-family:var(--f-num);letter-spacing:.2em;font-size:14px;color:var(--gold-glow);margin-top:18px;">YOU WON!</div>
              <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:30px;color:#fff;line-height:1;margin-top:4px;">{{ wonItem.name }}</div>
              <div style="font-size:13px;color:rgba(255,255,255,.75);font-weight:600;margin-top:10px;line-height:1.5;">Sign in to claim your prize and compete for monthly rewards!</div>
              <button onClick="{{ signInFromWheel }}" class="tap" style="width:100%;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:15px;padding:16px;border-radius:99px;border:0;margin-top:22px;box-shadow:0 10px 24px rgba(232,181,71,.4);">Sign in to claim →</button>
              <div onClick="{{ dismissWin }}" class="tap" style="color:rgba(255,255,255,.6);font-weight:700;font-size:13px;margin-top:14px;">Maybe later</div>
            </div>
          </div>
          </sc-if>

          <!-- LOSE OVERLAY -->
          <sc-if value="{{ showLoseResult }}" hint-placeholder-val="{{ false }}">
          <div style="position:absolute;inset:0;z-index:20;background:rgba(9,22,28,.72);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:30px;animation:floatIn .3s ease both;">
            <div style="width:100%;max-width:320px;background:var(--navy);border-radius:30px;padding:30px 26px;text-align:center;border:1px solid rgba(255,255,255,.1);box-shadow:0 30px 70px rgba(0,0,0,.5);animation:popIn .4s ease both;">
              <div style="width:120px;height:120px;border-radius:50%;margin:0 auto;background:rgba(255,255,255,.08);display:grid;place-items:center;font-size:60px;">😔</div>
              <div style="font-family:var(--f-num);letter-spacing:.2em;font-size:14px;color:rgba(255,255,255,.5);margin-top:18px;">BETTER LUCK NEXT TIME</div>
              <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:30px;color:#fff;line-height:1;margin-top:4px;">Try again!</div>
              <div style="font-size:13px;color:rgba(255,255,255,.6);font-weight:600;margin-top:6px;">Spin again tomorrow for another chance 🍹</div>
              <button onClick="{{ dismissLose }}" class="tap" style="width:100%;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:15px;padding:16px;border-radius:99px;border:0;margin-top:22px;">OK, I'll be back!</button>
            </div>
          </div>
          </sc-if>
        </div>
        </sc-if>

        <!-- ===================== PIÑA CHAT ===================== -->
        <sc-if value="{{ isPina }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .35s ease both;min-height:100%;display:flex;flex-direction:column;">
          <div style="padding:44px 20px 16px;background:linear-gradient(150deg,#FFC64D,#FF8A3D 60%,#FF6B35);color:#fff;display:flex;align-items:center;gap:12px;position:relative;overflow:hidden;">
            <div style="position:absolute;top:-14px;right:-6px;font-size:90px;opacity:.3;">🍍</div>
            <button onClick="{{ back }}" class="tap" style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.25);border:0;display:grid;place-items:center;backdrop-filter:blur(4px);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
            <div style="width:44px;height:44px;border-radius:50%;background:#fff;display:grid;place-items:center;font-size:26px;box-shadow:0 6px 14px rgba(0,0,0,.15);">🍍</div>
            <div style="position:relative;z-index:2;"><div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:22px;line-height:1;">Piña</div><div style="font-size:12px;color:rgba(255,255,255,.9);font-weight:600;display:flex;align-items:center;gap:5px;"><span style="width:7px;height:7px;border-radius:50%;background:var(--lime);box-shadow:0 0 0 3px rgba(163,230,53,.4);animation:pulseDot 1.6s infinite;"></span>your juice guide</div></div>
            <img src="assets/logo-clean-512.png" style="margin-left:auto;position:relative;z-index:2;height:28px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));" alt="Pour Decisions">
          </div>
          <div class="noscroll" style="flex:1;overflow-y:auto;padding:18px 16px;display:flex;flex-direction:column;gap:12px;">
            <sc-for list="{{ pinaMessages }}" as="m" hint-placeholder-count="2">
              <div style="align-self:{{ m.align }};max-width:80%;background:{{ m.bg }};color:{{ m.fg }};padding:13px 16px;border-radius:{{ m.radius }};font-size:14px;line-height:1.5;font-weight:500;box-shadow:0 4px 14px rgba(0,0,0,.14);">{{ m.text }}</div>
            </sc-for>
            <sc-if value="{{ typing }}" hint-placeholder-val="{{ false }}">
              <div style="align-self:flex-start;display:flex;gap:5px;background:rgba(255,255,255,.08);padding:15px 18px;border-radius:20px 20px 20px 6px;">
                <span style="width:7px;height:7px;border-radius:50%;background:var(--gold-glow);animation:pulseDot 1s ease-in-out infinite;"></span>
                <span style="width:7px;height:7px;border-radius:50%;background:var(--gold-glow);animation:pulseDot 1s ease-in-out .2s infinite;"></span>
                <span style="width:7px;height:7px;border-radius:50%;background:var(--gold-glow);animation:pulseDot 1s ease-in-out .4s infinite;"></span>
              </div>
            </sc-if>
          </div>
          <div style="padding:8px 14px 4px;">
            <div class="noscroll" style="display:flex;gap:8px;overflow-x:auto;padding-bottom:8px;">
              <sc-for list="{{ pinaSuggestions }}" as="q" hint-placeholder-count="3">
                <span onClick="{{ q.ask }}" class="tap" style="flex:0 0 auto;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:#fff;font-size:12.5px;font-weight:600;padding:9px 14px;border-radius:99px;">{{ q.label }}</span>
              </sc-for>
            </div>
          </div>
          <div style="padding:4px 14px 22px;display:flex;gap:10px;align-items:center;">
            <input value="{{ pinaInput }}" onInput="{{ onPinaInput }}" onKeyDown="{{ onPinaKey }}" placeholder="Ask Piña anything…" style="flex:1;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:99px;padding:14px 18px;color:#fff;font-size:14px;font-family:var(--f-body);outline:none;">
            <button onClick="{{ sendPina }}" class="tap" style="width:48px;height:48px;border-radius:50%;background:var(--gold);border:0;display:grid;place-items:center;box-shadow:0 8px 18px rgba(232,181,71,.4);flex:0 0 auto;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 12l16-8-6 16-2.5-6.5L4 12z" fill="#12303C"></path></svg>
            </button>
          </div>
        </div>
        </sc-if>

        <!-- ===================== EVENTS + VENUE RENTAL ===================== -->
        <sc-if value="{{ isEvents }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .35s ease both;padding-bottom:120px;">
          <div style="padding:44px 20px 24px;background:linear-gradient(160deg,#E8426A 0%,#C4284E 42%,#8B1A35 100%);color:#fff;position:relative;overflow:hidden;">
            <svg viewBox="0 0 240 520" style="position:absolute;left:-52px;top:60px;width:160px;height:auto;transform:scaleX(-1);pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.3)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <svg viewBox="0 0 240 520" style="position:absolute;right:-54px;top:10px;width:180px;height:auto;"><g fill="rgba(180,20,55,.25)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <div style="position:absolute;bottom:-20px;right:-14px;font-size:120px;opacity:.2;">📅</div>
            <div style="position:absolute;top:16px;right:10px;font-size:52px;animation:bobY 8s ease-in-out infinite;--r:-8deg;filter:drop-shadow(0 6px 10px rgba(0,0,0,.2));pointer-events:none;z-index:1;">🍊</div>
            <div style="position:absolute;bottom:14px;left:-6px;font-size:44px;animation:bobYr 10s ease-in-out infinite;filter:drop-shadow(0 6px 10px rgba(0,0,0,.18));pointer-events:none;z-index:1;">🥕</div>
            <div style="position:relative;z-index:2;margin-bottom:14px;"><img src="assets/logo-clean-512.png" style="height:32px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));" alt="Pour Decisions"></div>
            <div style="font-family:var(--f-num);letter-spacing:.22em;font-size:13px;color:rgba(255,255,255,.85);">EVENTS &amp; CLASSES</div>
            <h2 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:36px;line-height:.92;margin:8px 0 0;letter-spacing:-.03em;">What's on<br>this month</h2>
          </div>

          <!-- View toggle -->
          <div style="display:flex;gap:8px;margin:18px 16px 0;">
            <button onClick="{{ setEventsListView }}" class="tap" style="flex:1;padding:10px;border-radius:99px;border:0;background:{{ eventsListViewBg }};color:{{ eventsListViewFg }};font-weight:800;font-size:13px;cursor:pointer;">☰ List</button>
            <button onClick="{{ setEventsCalView }}" class="tap" style="flex:1;padding:10px;border-radius:99px;border:0;background:{{ eventsCalViewBg }};color:{{ eventsCalViewFg }};font-weight:800;font-size:13px;cursor:pointer;">📅 Calendar</button>
          </div>

          <!-- Calendar view -->
          <sc-if value="{{ isEventsCalView }}" hint-placeholder-val="{{ false }}">
          <div style="margin:16px 16px 0;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:16px;">
            <div style="text-align:center;font-weight:800;color:#fff;font-size:16px;margin-bottom:14px;">{{ calendarMonthLabel }}</div>
            <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-bottom:8px;">
              <div style="text-align:center;font-size:11px;color:rgba(255,255,255,.4);font-weight:700;padding:4px;">S</div>
              <div style="text-align:center;font-size:11px;color:rgba(255,255,255,.4);font-weight:700;padding:4px;">M</div>
              <div style="text-align:center;font-size:11px;color:rgba(255,255,255,.4);font-weight:700;padding:4px;">T</div>
              <div style="text-align:center;font-size:11px;color:rgba(255,255,255,.4);font-weight:700;padding:4px;">W</div>
              <div style="text-align:center;font-size:11px;color:rgba(255,255,255,.4);font-weight:700;padding:4px;">T</div>
              <div style="text-align:center;font-size:11px;color:rgba(255,255,255,.4);font-weight:700;padding:4px;">F</div>
              <div style="text-align:center;font-size:11px;color:rgba(255,255,255,.4);font-weight:700;padding:4px;">S</div>
            </div>
            <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;">
              <sc-for list="{{ calendarDays }}" as="cd">
                <div style="text-align:center;padding:6px 2px;border-radius:10px;position:relative;background:{{ cd.hasEvent ? 'rgba(232,181,71,.15)' : 'transparent' }};">
                  <span style="font-size:13px;font-weight:{{ cd.isToday ? 800 : 500 }};color:{{ cd.isToday ? 'var(--gold)' : cd.empty ? 'transparent' : 'rgba(255,255,255,.75)' }};">{{ cd.label }}</span>
                  <sc-if value="{{ cd.hasEvent }}" hint-placeholder-val="{{ false }}">
                    <div style="width:5px;height:5px;border-radius:50%;background:var(--gold);margin:2px auto 0;"></div>
                  </sc-if>
                </div>
              </sc-for>
            </div>
          </div>
          </sc-if>

          <!-- List view -->
          <sc-if value="{{ isEventsListView }}" hint-placeholder-val="{{ true }}">
          <div style="padding:16px 16px 0;">
            <div style="font-family:var(--f-num);letter-spacing:.16em;font-size:13px;color:var(--gold-glow);margin-bottom:12px;">UPCOMING EVENTS</div>
            <sc-if value="{{ hasEvents }}" hint-placeholder-val="{{ true }}">
            <div style="display:flex;flex-direction:column;gap:14px;">
              <sc-for list="{{ upcomingEvents }}" as="ev" hint-placeholder-count="3">
                <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:22px;padding:16px;">
                  <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">
                    <div style="width:54px;height:54px;border-radius:16px;background:rgba(255,255,255,.1);display:grid;place-items:center;font-size:28px;flex:0 0 54px;">{{ ev.emoji }}</div>
                    <div style="flex:1;">
                      <div style="font-weight:800;color:#fff;font-size:15px;line-height:1.2;">{{ ev.title }}</div>
                      <div style="font-size:12px;color:rgba(255,255,255,.6);margin-top:3px;">{{ ev.dateLabel }} · {{ ev.time }}</div>
                    </div>
                    <span style="font-size:12px;font-weight:800;color:var(--gold-glow);background:rgba(232,181,71,.12);padding:5px 10px;border-radius:99px;">{{ ev.priceLabel }}</span>
                  </div>
                  <p style="font-size:13px;color:rgba(255,255,255,.65);margin:0 0 12px;line-height:1.5;">{{ ev.desc }}</p>
                  <button onClick="{{ ev.rsvpFn }}" class="tap" style="width:100%;background:{{ ev.rsvpBg }};color:{{ ev.rsvpFg }};font-weight:800;font-size:14px;padding:12px;border-radius:99px;border:0;">{{ ev.rsvpLabel }}</button>
                </div>
              </sc-for>
            </div>
            </sc-if>
            <sc-if value="{{ noEvents }}" hint-placeholder-val="{{ false }}">
            <div style="text-align:center;padding:30px 20px;color:rgba(255,255,255,.6);">
              <div style="font-size:54px;margin-bottom:12px;">📅</div>
              <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:22px;color:#fff;">No events coming up</div>
              <p style="font-size:13px;margin-top:8px;">Check back soon for workshops, pop-ups and more.</p>
            </div>
            </sc-if>

            <!-- VENUE RENTAL -->
            <div style="margin-top:28px;">
              <div style="font-family:var(--f-num);letter-spacing:.16em;font-size:13px;color:var(--gold-glow);margin-bottom:4px;">RENT OUR SPACE</div>
              <div style="font-size:12px;color:rgba(255,255,255,.5);font-weight:600;margin-bottom:12px;">275 Lark St · Up to 30 guests · Albany NY</div>
              <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;">
                <sc-for list="{{ venueSlots }}" as="vs" hint-placeholder-count="3">
                  <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:14px 16px;display:flex;align-items:center;gap:10px;">
                    <div style="flex:1;">
                      <div style="font-weight:800;color:#fff;font-size:14px;">{{ vs.dateLabel }}</div>
                      <div style="font-size:12px;color:rgba(255,255,255,.6);margin-top:2px;">{{ vs.time }} · {{ vs.capacity }} guests max</div>
                      <div style="display:flex;align-items:center;gap:8px;margin-top:6px;">
                        <span style="font-family:var(--f-num);font-size:18px;color:var(--gold-glow);">{{ vs.priceLabel }}</span>
                        <span style="font-size:10px;font-weight:700;padding:3px 8px;border-radius:99px;background:{{ vs.statusBg }};color:{{ vs.statusFg }};">{{ vs.statusLabel }}</span>
                      </div>
                    </div>
                    <sc-if value="{{ vs.isAvail }}" hint-placeholder-val="{{ true }}">
                    <button onClick="{{ vs.inquireFn }}" class="tap" style="background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:12px;padding:10px 16px;border-radius:99px;border:0;flex:0 0 auto;">Inquire</button>
                    </sc-if>
                  </div>
                </sc-for>
              </div>

              <!-- Rental inquiry form -->
              <div id="pd-rental-form" style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:22px;padding:18px;">
                <div style="font-weight:800;color:#fff;font-size:15px;margin-bottom:14px;">Inquire about a rental</div>
                <sc-if value="{{ rentalSent }}" hint-placeholder-val="{{ false }}">
                <div style="text-align:center;padding:20px;color:#A3E635;font-weight:700;font-size:15px;">We'll be in touch within 24 hours! 🌿</div>
                </sc-if>
                <sc-if value="{{ rentalNotSent }}" hint-placeholder-val="{{ true }}">
                <div style="display:flex;flex-direction:column;gap:10px;">
                  <input value="{{ rentalName }}" onInput="{{ onRentalName }}" placeholder="Your name" style="width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:13px 16px;color:#fff;font-size:14px;font-family:var(--f-body);outline:none;">
                  <input value="{{ rentalEmail }}" onInput="{{ onRentalEmail }}" placeholder="Email address" style="width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:13px 16px;color:#fff;font-size:14px;font-family:var(--f-body);outline:none;">
                  <input type="date" value="{{ rentalDate }}" onInput="{{ onRentalDate }}" style="width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:13px 16px;color:#fff;font-size:14px;font-family:var(--f-body);outline:none;">
                  <textarea value="{{ rentalNote }}" onInput="{{ onRentalNote }}" placeholder="Notes or questions…" style="width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:13px 16px;color:#fff;font-size:14px;font-family:var(--f-body);outline:none;resize:none;min-height:80px;"></textarea>
                  <button onClick="{{ submitRental }}" class="tap" style="width:100%;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:15px;padding:14px;border-radius:99px;border:0;opacity:{{ rentalFormReady ? 1 : 0.45 }};">Send Inquiry</button>
                </div>
                </sc-if>
              </div>
            </div>
          </div>
          </sc-if><!-- end isEventsListView -->
        </div>
        </sc-if>

        <!-- ===================== PRIZES PAGE ===================== -->
        <sc-if value="{{ isPrizes }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .35s ease both;padding-bottom:120px;">
          <div style="padding:44px 20px 24px;background:linear-gradient(160deg,#E8426A 0%,#C4284E 42%,#8B1A35 100%);color:#fff;position:relative;overflow:hidden;display:flex;align-items:center;gap:12px;">
            <svg viewBox="0 0 240 520" style="position:absolute;left:-52px;top:60px;width:160px;height:auto;transform:scaleX(-1);pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.3)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <div style="position:absolute;bottom:-20px;right:-14px;font-size:120px;opacity:.2;">🏆</div>
            <div style="position:absolute;top:14px;left:-8px;font-size:52px;animation:bobY 9s ease-in-out infinite;--r:12deg;filter:drop-shadow(0 6px 10px rgba(0,0,0,.2));pointer-events:none;z-index:1;">🥝</div>
            <div style="position:absolute;top:16px;right:60px;font-size:44px;animation:bobYr 11s ease-in-out infinite;filter:drop-shadow(0 6px 10px rgba(0,0,0,.18));pointer-events:none;z-index:1;">🥦</div>
            <button onClick="{{ back }}" class="tap" style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.25);border:0;display:grid;place-items:center;backdrop-filter:blur(4px);flex:0 0 40px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
            <img src="assets/logo-clean-512.png" style="height:32px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));" alt="Pour Decisions">
            <h2 style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:26px;color:#fff;margin:0;letter-spacing:-.02em;position:relative;z-index:2;">Your Prizes</h2>
          </div>
          <div style="padding:20px 16px 0;">
            <sc-if value="{{ hasPrizes }}" hint-placeholder-val="{{ false }}">
            <div style="display:flex;flex-direction:column;gap:14px;">
              <sc-for list="{{ userPrizes }}" as="p" hint-placeholder-count="2">
                <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:22px;padding:16px;">
                  <div style="display:flex;align-items:center;gap:14px;">
                    <div style="width:64px;height:64px;border-radius:50%;background:rgba(255,255,255,.1);display:grid;place-items:center;font-size:36px;flex:0 0 64px;">{{ p.emoji }}</div>
                    <div style="flex:1;">
                      <div style="font-weight:800;color:#fff;font-size:16px;">{{ p.name }}</div>
                      <div style="font-size:12px;color:rgba(255,255,255,.5);margin-top:2px;">Won {{ p.wonDateLabel }}</div>
                      <span style="font-size:10px;font-weight:700;padding:3px 8px;border-radius:99px;background:{{ p.statusBg }};color:{{ p.statusFg }};display:inline-block;margin-top:5px;">{{ p.statusLabel }}</span>
                    </div>
                    <sc-if value="{{ p.isUnclaimed }}" hint-placeholder-val="{{ false }}">
                    <button onClick="{{ p.claimFn }}" class="tap" style="background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:12px;padding:10px 14px;border-radius:99px;border:0;flex:0 0 auto;">Claim →</button>
                    </sc-if>
                  </div>
                </div>
              </sc-for>
            </div>
            </sc-if>
            <sc-if value="{{ noPrizes }}" hint-placeholder-val="{{ true }}">
            <div style="text-align:center;padding:60px 20px;color:rgba(255,255,255,.6);">
              <div style="font-size:72px;margin-bottom:16px;">🏆</div>
              <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:26px;color:#fff;margin-bottom:8px;">No prizes yet</div>
              <p style="font-size:14px;margin:0 0 20px;max-width:22ch;margin-left:auto;margin-right:auto;">Spin the daily prize wheel to win free pours</p>
              <button onClick="{{ goWheel }}" class="tap" style="background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:15px;padding:14px 28px;border-radius:99px;border:0;">🎡 Spin the wheel</button>
            </div>
            </sc-if>
          </div>
        </div>
        </sc-if>

        <!-- ===================== ADMIN PANEL ===================== -->
        <sc-if value="{{ isAdmin }}" hint-placeholder-val="{{ false }}">
        <div style="animation:floatIn .35s ease both;min-height:100dvh;padding-bottom:40px;">
          <!-- LOGIN -->
          <sc-if value="{{ adminIsLogin }}" hint-placeholder-val="{{ true }}">
          <div style="min-height:100dvh;display:flex;flex-direction:column;background:var(--navy);color:#fff;">
            <div style="padding:60px 24px 30px;text-align:center;background:linear-gradient(160deg,#E8426A 0%,#C4284E 60%,#8B1A35 100%);position:relative;overflow:hidden;">
              <svg viewBox="0 0 240 520" style="position:absolute;left:-52px;top:60px;width:160px;height:auto;transform:scaleX(-1);pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.3)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <svg viewBox="0 0 240 520" style="position:absolute;right:-58px;top:20px;width:220px;height:auto;pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.22)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <div style="position:absolute;top:14px;left:-8px;font-size:40px;opacity:.45;animation:bobY 11s ease-in-out infinite;--r:8deg;pointer-events:none;z-index:1;">🥕</div>
            <div style="position:absolute;top:20px;right:-6px;font-size:34px;opacity:.4;animation:bobYr 13s ease-in-out infinite;pointer-events:none;z-index:1;">🌿</div>
            <div style="position:relative;z-index:2;font-size:48px;margin-bottom:12px;">🔐</div>
              <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:30px;letter-spacing:-.02em;position:relative;z-index:2;">Pour Decisions Admin</div>
              <div style="font-size:13px;color:rgba(255,255,255,.7);margin-top:4px;position:relative;z-index:2;">Authorized personnel only</div>
            </div>
            <div style="padding:30px 24px;flex:1;">
              <input value="{{ adminEmail }}" onInput="{{ onAdminEmail }}" placeholder="Admin email" style="width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:15px 18px;color:#fff;font-size:14px;font-family:var(--f-body);outline:none;margin-bottom:12px;">
              <input type="password" value="{{ adminPassword }}" onInput="{{ onAdminPassword }}" placeholder="Password" style="width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:15px 18px;color:#fff;font-size:14px;font-family:var(--f-body);outline:none;margin-bottom:8px;">
              <sc-if value="{{ adminLoginError }}" hint-placeholder-val="{{ false }}">
              <div style="color:#FF7A8A;font-size:13px;font-weight:600;margin-bottom:12px;">{{ adminLoginError }}</div>
              </sc-if>
              <button onClick="{{ doAdminSignIn }}" class="tap" style="width:100%;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:16px;padding:17px;border-radius:99px;border:0;margin-top:8px;box-shadow:0 10px 24px rgba(232,181,71,.35);">Sign in</button>
              <button onClick="{{ back }}" class="tap" style="width:100%;background:transparent;color:rgba(255,255,255,.5);font-weight:700;font-size:14px;padding:14px;border-radius:99px;border:0;margin-top:8px;">← Back</button>
            </div>
          </div>
          </sc-if>

          <!-- DASHBOARD -->
          <sc-if value="{{ adminIsDash }}" hint-placeholder-val="{{ false }}">
          <div style="background:var(--navy);min-height:100dvh;">
            <div style="padding:44px 20px 16px;background:linear-gradient(160deg,#E8426A 0%,#C4284E 60%,#8B1A35 100%);display:flex;align-items:center;gap:10px;position:relative;overflow:hidden;">
              <svg viewBox="0 0 240 520" style="position:absolute;left:-52px;top:60px;width:160px;height:auto;transform:scaleX(-1);pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.3)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            <svg viewBox="0 0 240 520" style="position:absolute;right:-58px;top:20px;width:220px;height:auto;pointer-events:none;" aria-hidden="true"><g fill="rgba(180,20,55,.22)"><path d="M104 520 C112 400 122 280 146 160 L158 164 C138 280 130 400 126 520 Z"></path><path d="M152 158 C110 118 48 114 12 140 C56 94 128 106 152 138 Z"></path><path d="M150 162 C112 168 70 200 58 242 C64 188 108 150 148 148 Z"></path><path d="M154 158 C196 118 228 116 238 142 C212 98 162 106 152 138 Z"></path><path d="M156 162 C194 170 222 204 228 246 C216 190 180 152 154 148 Z"></path><path d="M152 156 C150 108 166 66 192 50 C158 62 138 108 146 150 Z"></path><path d="M150 154 C132 110 94 82 58 78 C104 70 140 102 154 144 Z"></path><circle cx="146" cy="166" r="9"></circle><circle cx="161" cy="170" r="8"></circle></g></svg>
            
              <div style="position:absolute;top:12px;right:80px;font-size:38px;opacity:.4;animation:bobY 10s ease-in-out infinite;--r:-6deg;pointer-events:none;z-index:1;">🍋</div>
              <div style="position:absolute;bottom:8px;left:8px;font-size:32px;opacity:.35;animation:bobYr 13s ease-in-out infinite;pointer-events:none;z-index:1;">🥕</div>
              <div style="flex:1;position:relative;z-index:2;">
                <div style="font-family:var(--f-num);letter-spacing:.15em;font-size:12px;color:var(--gold-glow);">ADMIN</div>
                <div style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:22px;color:#fff;">Dashboard</div>
              </div>
              <img src="assets/logo-clean-512.png" style="height:28px;width:auto;display:block;filter:drop-shadow(0 3px 10px rgba(0,0,0,.35));position:relative;z-index:2;" alt="Pour Decisions">
              <button onClick="{{ doAdminSignOut }}" class="tap" style="background:rgba(255,255,255,.1);color:#fff;font-weight:700;font-size:12px;padding:8px 14px;border-radius:99px;border:0;">Sign out</button>
            </div>
            <!-- Admin tabs -->
            <div class="noscroll" style="display:flex;gap:0;overflow-x:auto;background:var(--navy-mid);border-bottom:1px solid rgba(255,255,255,.08);padding:0 16px;">
              <button onClick="{{ setAdminDash }}" class="tap" style="flex:0 0 auto;background:transparent;color:{{ isAdminDash?'var(--gold)':'rgba(255,255,255,.5)' }};font-weight:{{ isAdminDash?800:700 }};font-size:13px;padding:12px 14px;border:0;border-bottom:2px solid {{ isAdminDash?'var(--gold)':'transparent' }};">Dashboard</button>
              <button onClick="{{ setAdminEvents }}" class="tap" style="flex:0 0 auto;background:transparent;color:{{ isAdminEvents?'var(--gold)':'rgba(255,255,255,.5)' }};font-weight:{{ isAdminEvents?800:700 }};font-size:13px;padding:12px 14px;border:0;border-bottom:2px solid {{ isAdminEvents?'var(--gold)':'transparent' }};">Events</button>
              <button onClick="{{ setAdminVenue }}" class="tap" style="flex:0 0 auto;background:transparent;color:{{ isAdminVenue?'var(--gold)':'rgba(255,255,255,.5)' }};font-weight:{{ isAdminVenue?800:700 }};font-size:13px;padding:12px 14px;border:0;border-bottom:2px solid {{ isAdminVenue?'var(--gold)':'transparent' }};">Venue</button>
              <button onClick="{{ setAdminPrizes }}" class="tap" style="flex:0 0 auto;background:transparent;color:{{ isAdminPrizes?'var(--gold)':'rgba(255,255,255,.5)' }};font-weight:{{ isAdminPrizes?800:700 }};font-size:13px;padding:12px 14px;border:0;border-bottom:2px solid {{ isAdminPrizes?'var(--gold)':'transparent' }};">Prizes</button>
              <button onClick="{{ setAdminOrders }}" class="tap" style="flex:0 0 auto;background:transparent;color:{{ isAdminOrders?'var(--gold)':'rgba(255,255,255,.5)' }};font-weight:{{ isAdminOrders?800:700 }};font-size:13px;padding:12px 14px;border:0;border-bottom:2px solid {{ isAdminOrders?'var(--gold)':'transparent' }};">Orders</button>
            </div>
            <div style="padding:16px;">
              <!-- Dashboard tab -->
              <sc-if value="{{ isAdminDash }}" hint-placeholder-val="{{ true }}">
              <div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;">
                  <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:14px;text-align:center;"><div style="font-family:var(--f-num);font-size:30px;color:var(--gold-glow);">{{ adminTotalOrders }}</div><div style="font-size:11px;color:rgba(255,255,255,.5);font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-top:4px;">Total Orders</div></div>
                  <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:14px;text-align:center;"><div style="font-family:var(--f-num);font-size:30px;color:var(--gold-glow);">{{ points }}</div><div style="font-size:11px;color:rgba(255,255,255,.5);font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-top:4px;">Points Issued</div></div>
                  <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:14px;text-align:center;"><div style="font-family:var(--f-num);font-size:30px;color:var(--gold-glow);">{{ adminUnclaimedPrizes }}</div><div style="font-size:11px;color:rgba(255,255,255,.5);font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-top:4px;">Unclaimed Prizes</div></div>
                  <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:14px;text-align:center;"><div style="font-family:var(--f-num);font-size:30px;color:var(--gold-glow);">{{ adminTotalEvents }}</div><div style="font-size:11px;color:rgba(255,255,255,.5);font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-top:4px;">Events</div></div>
                </div>
                <div style="font-family:var(--f-num);letter-spacing:.14em;font-size:12px;color:var(--gold-glow);margin-bottom:10px;">RECENT ORDERS</div>
                <div style="display:flex;flex-direction:column;gap:8px;">
                  <sc-for list="{{ adminOrders }}" as="o" hint-placeholder-count="3">
                    <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:12px 14px;display:flex;align-items:center;gap:10px;">
                      <span style="font-family:var(--f-num);font-size:16px;color:var(--gold-glow);flex:0 0 auto;">{{ o.idLabel }}</span>
                      <span style="flex:1;font-size:12px;color:rgba(255,255,255,.6);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ o.itemSummary }}</span>
                      <span style="font-family:var(--f-num);font-size:16px;color:#fff;flex:0 0 auto;">{{ o.totalLabel }}</span>
                    </div>
                  </sc-for>
                </div>
              </div>
              </sc-if>
              <!-- Events tab -->
              <sc-if value="{{ isAdminEvents }}" hint-placeholder-val="{{ false }}">
              <div>
                <button onClick="{{ showAddEventForm }}" class="tap" style="width:100%;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:14px;padding:13px;border-radius:99px;border:0;margin-bottom:14px;">+ Add Event</button>
                <sc-if value="{{ showAdminEventForm }}" hint-placeholder-val="{{ false }}">
                <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:18px;padding:16px;margin-bottom:14px;display:flex;flex-direction:column;gap:10px;">
                  <input value="{{ adminEventForm.title }}" onInput="{{ onAdminEvTitle }}" placeholder="Event title" style="width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:12px 14px;color:#fff;font-size:13px;font-family:var(--f-body);outline:none;">
                  <input type="date" value="{{ adminEventForm.date }}" onInput="{{ onAdminEvDate }}" style="width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:12px 14px;color:#fff;font-size:13px;font-family:var(--f-body);outline:none;">
                  <input value="{{ adminEventForm.time }}" onInput="{{ onAdminEvTime }}" placeholder="Time (e.g. 11:00 AM)" style="width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:12px 14px;color:#fff;font-size:13px;font-family:var(--f-body);outline:none;">
                  <textarea value="{{ adminEventForm.desc }}" onInput="{{ onAdminEvDesc }}" placeholder="Description" style="width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:12px 14px;color:#fff;font-size:13px;font-family:var(--f-body);outline:none;resize:none;min-height:70px;"></textarea>
                  <input type="number" value="{{ adminEventForm.price }}" onInput="{{ onAdminEvPrice }}" placeholder="Price (0 for free)" style="width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:12px 14px;color:#fff;font-size:13px;font-family:var(--f-body);outline:none;">
                  <input value="{{ adminEventForm.emoji }}" onInput="{{ onAdminEvEmoji }}" placeholder="Emoji" style="width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:12px 14px;color:#fff;font-size:13px;font-family:var(--f-body);outline:none;">
                  <div style="display:flex;gap:10px;">
                    <button onClick="{{ saveAdminEvent }}" class="tap" style="flex:1;background:var(--gold);color:var(--teal-deep);font-weight:800;font-size:14px;padding:12px;border-radius:99px;border:0;">Save</button>
                    <button onClick="{{ cancelAdminEvent }}" class="tap" style="flex:1;background:rgba(255,255,255,.08);color:#fff;font-weight:700;font-size:14px;padding:12px;border-radius:99px;border:0;">Cancel</button>
                  </div>
                </div>
                </sc-if>
                <div style="display:flex;flex-direction:column;gap:10px;">
                  <sc-for list="{{ adminEvents }}" as="ev" hint-placeholder-count="3">
                    <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:16px;padding:13px 14px;display:flex;align-items:center;gap:10px;">
                      <span style="font-size:26px;flex:0 0 auto;">{{ ev.emoji }}</span>
                      <div style="flex:1;min-width:0;">
                        <div style="font-weight:800;color:#fff;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ ev.title }}</div>
                        <div style="font-size:11px;color:rgba(255,255,255,.5);">{{ ev.date }} · {{ ev.priceLabel }}</div>
                      </div>
                      <button onClick="{{ ev.deleteAdminEvent }}" class="tap" style="background:rgba(255,61,128,.15);color:#FF3D80;font-weight:700;font-size:11px;padding:7px 12px;border-radius:99px;border:0;flex:0 0 auto;">Delete</button>
                    </div>
                  </sc-for>
                </div>
              </div>
              </sc-if>
              <!-- Venue tab -->
              <sc-if value="{{ isAdminVenue }}" hint-placeholder-val="{{ false }}">
              <div style="display:flex;flex-direction:column;gap:10px;">
                <sc-for list="{{ adminVenue }}" as="v" hint-placeholder-count="3">
                  <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:16px;padding:13px 14px;display:flex;align-items:center;gap:10px;">
                    <div style="flex:1;">
                      <div style="font-weight:800;color:#fff;font-size:14px;">{{ v.date }}</div>
                      <div style="font-size:12px;color:rgba(255,255,255,.5);">{{ v.time }} · ${{ v.price }}</div>
                    </div>
                    <button onClick="{{ v.toggleFn }}" class="tap" style="background:{{ v.status==='available'?'rgba(163,230,53,.15)':'rgba(255,61,128,.15)' }};color:{{ v.status==='available'?'#A3E635':'#FF3D80' }};font-weight:700;font-size:11px;padding:7px 12px;border-radius:99px;border:0;flex:0 0 auto;">{{ v.status }}</button>
                  </div>
                </sc-for>
              </div>
              </sc-if>
              <!-- Prizes tab -->
              <sc-if value="{{ isAdminPrizes }}" hint-placeholder-val="{{ false }}">
              <div style="display:flex;flex-direction:column;gap:10px;">
                <sc-for list="{{ adminPrizes }}" as="p" hint-placeholder-count="2">
                  <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:16px;padding:13px 14px;display:flex;align-items:center;gap:12px;">
                    <span style="font-size:24px;flex:0 0 auto;">{{ p.emoji }}</span>
                    <div style="flex:1;">
                      <div style="font-weight:800;color:#fff;font-size:14px;">{{ p.name }}</div>
                      <div style="font-size:11px;color:rgba(255,255,255,.5);">{{ p.wonDate }}</div>
                    </div>
                    <span style="font-size:10px;font-weight:700;padding:4px 10px;border-radius:99px;background:{{ p.statusBg }};color:{{ p.statusFg }};">{{ p.statusLabel }}</span>
                  </div>
                </sc-for>
              </div>
              </sc-if>
              <!-- Orders tab -->
              <sc-if value="{{ isAdminOrders }}" hint-placeholder-val="{{ false }}">
              <div style="display:flex;flex-direction:column;gap:10px;">
                <sc-for list="{{ adminOrders }}" as="o" hint-placeholder-count="3">
                  <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:16px;padding:13px 14px;">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;">
                      <span style="font-family:var(--f-num);font-size:17px;color:var(--gold-glow);">{{ o.idLabel }}</span>
                      <span style="font-family:var(--f-num);font-size:17px;color:#fff;">{{ o.totalLabel }}</span>
                    </div>
                    <div style="font-size:12px;color:rgba(255,255,255,.5);">{{ o.itemSummary }}</div>
                  </div>
                </sc-for>
              </div>
              </sc-if>
            </div>
          </div>
          </sc-if>
        </div>
        </sc-if>

      </div>

      <!-- Floating Piña button -->
      <sc-if value="{{ showPinaFab }}" hint-placeholder-val="{{ true }}">
      <button onClick="{{ goPina }}" class="tap pd-pina-fab" style="position:absolute;right:14px;bottom:92px;z-index:80;display:flex;align-items:center;gap:8px;background:var(--cream);border:0;border-radius:999px;padding:7px 15px 7px 7px;box-shadow:0 10px 26px rgba(14,32,41,.38),0 2px 8px rgba(14,32,41,.18);">
        <span style="position:relative;width:32px;height:32px;border-radius:50%;background:var(--teal-deep);display:grid;place-items:center;font-size:16px;">🍍<span style="position:absolute;bottom:0;right:-1px;width:9px;height:9px;border-radius:50%;background:var(--lime);border:2px solid var(--cream);"></span></span>
        <span style="font-family:var(--f-display);font-style:italic;font-weight:900;font-size:15px;color:var(--teal-deep);letter-spacing:-.01em;">Ask Piña</span>
      </button>
      </sc-if>

      </div><!-- end pd-main-scroll -->

      <!-- BOTTOM NAV — hidden on desktop via CSS -->
      <div class="pd-bottom-nav-wrap">
      <sc-if value="{{ showNav }}" hint-placeholder-val="{{ false }}">
      <div style="position:relative;z-index:85;display:grid;grid-template-columns:repeat(5,1fr);padding:10px 8px 22px;background:rgba(28,31,46,.96);backdrop-filter:blur(16px);border-top:1px solid rgba(255,255,255,.08);">
        <sc-for list="{{ navItems }}" as="n" hint-placeholder-count="5">
          <div onClick="{{ n.go }}" class="tap" style="display:flex;flex-direction:column;align-items:center;gap:3px;color:{{ n.color }};font-size:10px;font-weight:{{ n.weight }};">
            <span style="font-size:19px;">{{ n.icon }}</span><span>{{ n.label }}</span>
          </div>
        </sc-for>
      </div>
      </sc-if>
      </div><!-- end pd-bottom-nav-wrap -->
  </div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;$preview&quot;:{&quot;width&quot;:460,&quot;height&quot;:1000},&quot;splashTheme&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;Sunset&quot;,&quot;Citrus&quot;,&quot;Berry&quot;],&quot;default&quot;:&quot;Berry&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Theme&quot;},&quot;showFruitStickers&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Theme&quot;},&quot;menuCategory&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;All&quot;,&quot;Juices&quot;,&quot;Smoothies&quot;,&quot;Bowls&quot;,&quot;Shots&quot;],&quot;default&quot;:&quot;All&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Menu&quot;}}">
